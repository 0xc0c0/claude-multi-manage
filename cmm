#!/usr/bin/env bash
# cmm - claude-multi-manage
# Start and manage multiple `claude` sessions on one host via tmux.

set -euo pipefail

VERSION="0.4.0"
PROG="$(basename "${0}")"
SESSION_PREFIX="claude-"
MAINT_SESSION="cmm-maintain"
LEGACY_SESSION="cmm-keepalive"   # what the daemon was called before 0.4.0
STATE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/cmm"
MAINT_LOG="$STATE_DIR/maintain.log"
LOG_MAX_BYTES=$(( 1024 * 1024 ))
CLAUDE_DIR="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
# Claude offers to resume long sessions "from a summary"; that prompt would
# block an unattended restart and throw away the context cmm is preserving.
# Its threshold is an env var, so a big one turns the prompt off.
RESUME_PROMPT_OFF="CLAUDE_CODE_RESUME_THRESHOLD_MINUTES=999999999"

# ---------- helpers ----------

die()  { printf 'error: %s\n' "$*" >&2; exit 1; }
warn() { printf 'warning: %s\n' "$*" >&2; }
log()  {
  local line
  line="[$(date '+%Y-%m-%d %H:%M:%S')] $*"
  printf '%s\n' "$line"
  if [ -n "${CMM_LOG:-}" ]; then printf '%s\n' "$line" >> "$CMM_LOG" 2>/dev/null || true; fi
}

need() {
  command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"
}

# Resolve the real path to this script (used by `install` and `keepalive --daemon`).
_self_path() {
  local src="${BASH_SOURCE[0]}" dir
  while [ -h "$src" ]; do
    dir="$(cd -P "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    [[ $src != /* ]] && src="$dir/$src"
  done
  cd -P "$(dirname "$src")" && printf '%s/%s\n' "$(pwd)" "$(basename "$src")"
}

_human_age() {
  local now then secs
  now=$(date +%s); then=$1; secs=$(( now - then ))
  if   (( secs <    60 )); then printf '%ds ago' "$secs"
  elif (( secs <  3600 )); then printf '%dm ago' $(( secs /    60 ))
  elif (( secs < 86400 )); then printf '%dh ago' $(( secs /  3600 ))
  else                          printf '%dd ago' $(( secs / 86400 ))
  fi
}

# Quote arguments for a POSIX shell. tmux runs pane commands through the
# user's shell, so every argument we hand it must be quoted.
_shell_join() {
  local out="" a q="'"
  for a in "$@"; do
    a="$q${a//$q/$q\\$q$q}$q"
    out="${out:+$out }$a"
  done
  printf '%s' "$out"
}

# Only one thing may drive sessions on this host at a time, so a maintenance
# pass can never collide with a second pass or with an interactive update.
# $1 = seconds to wait for the lock (0 = give up immediately).
_lock_acquire() {
  local wait="${1:-0}" i=0 owner age
  mkdir -p "$STATE_DIR" 2>/dev/null || true
  while :; do
    if mkdir "$STATE_DIR/lock" 2>/dev/null; then
      printf '%s %s\n' "$$" "$(date +%s)" > "$STATE_DIR/lock/owner" 2>/dev/null || true
      CMM_LOCKED=1
      trap _lock_release EXIT INT TERM
      return 0
    fi
    # break a lock left behind by a run that died (nothing here takes an hour)
    owner=$(cat "$STATE_DIR/lock/owner" 2>/dev/null) || owner=""
    age=$(printf '%s' "$owner" | awk '{print $2}')
    if [ -n "$age" ] && [ $(( $(date +%s) - age )) -gt 3600 ]; then
      warn "removing a stale lock from $(printf '%s' "$owner" | awk '{print $1}')"
      rm -rf "$STATE_DIR/lock" 2>/dev/null || true
      continue
    fi
    [ "$i" -lt "$wait" ] || return 1
    i=$(( i + 1 )); sleep 1
  done
}

_lock_release() {
  [ "${CMM_LOCKED:-0}" = "1" ] || return 0
  CMM_LOCKED=0
  rm -rf "$STATE_DIR/lock" 2>/dev/null || true
}

# Session-scoped notes cmm keeps for itself, as tmux user options: they live
# and die with the session and need no state file. (set-option/show-options
# do not take the '=' exact-match prefix, but session names are exact anyway.)
_sess_get() { tmux show-options -v -t "$1" "$2" 2>/dev/null || true; }
_sess_set() { tmux set-option -t "$1" "$2" "$3" >/dev/null 2>&1 || true; }

# Print "NAME|ATTACHED|CREATED_EPOCH|PATH" for matching sessions, one per line.
# scope = "here" (under $PWD) or "all".
#
# The separator is '|' and the path comes last on purpose: without a UTF-8
# locale (in a cron job, say) tmux rewrites unprintable characters in -F output,
# turning a tab separator into '_', and a path is the only field that could
# contain the separator itself.
_collect_sessions() {
  local scope="$1"
  tmux list-sessions \
    -F '#{session_name}|#{session_attached}|#{session_created}|#{session_path}' \
    2>/dev/null \
    | awk -v prefix="$SESSION_PREFIX" -v here="$PWD" -v scope="$scope" '
        index($0, prefix) == 1 {
          path = $0
          sub(/^[^|]*\|[^|]*\|[^|]*\|/, "", path)
          if (scope == "all") { print; next }
          if (path == here || index(path, here "/") == 1) print
        }'
}

# Attach to a session; switch-client if we are already inside tmux.
_attach() {
  if [ -n "${TMUX:-}" ]; then
    tmux switch-client -t "$1"
  else
    tmux attach -t "$1"
  fi
}

# Resolve a session reference (list #, full name, or name without the
# 'claude-' prefix) to a tmux session name. Dies if nothing matches.
_resolve_session() {
  local arg="$1" rows target=""
  if [[ "$arg" =~ ^[0-9]+$ ]]; then
    rows=$(_collect_sessions "here") || true
    target=$(awk -F'[|]' -v n="$arg" 'NR==n {print $1; exit}' <<< "$rows")
    [ -n "$target" ] || die "no session #$arg in list (under $PWD)"
  elif tmux has-session -t "=$arg" 2>/dev/null; then
    target="$arg"
  elif tmux has-session -t "=${SESSION_PREFIX}${arg}" 2>/dev/null; then
    target="${SESSION_PREFIX}${arg}"
  else
    die "no session matches: $arg"
  fi
  printf '%s\n' "$target"
}

# Show the list under $PWD and let the user pick one; prints the session name.
_pick_session() {
  local rows arg
  rows=$(_collect_sessions "here") || true
  [ -n "$rows" ] || die "no claude sessions under $PWD (try '$PROG new' or '$PROG list --all')"
  cmd_list >&2
  printf '\nselect # (or name): ' >&2
  read -r arg || die "no selection"
  [ -n "$arg" ] || die "no selection"
  _resolve_session "$arg"
}

# The cmm session this command is running inside, if any.
_current_session() {
  local n
  [ -n "${TMUX:-}" ] || return 0
  n=$(tmux display-message -p '#{session_name}' 2>/dev/null) || return 0
  case "$n" in "$SESSION_PREFIX"*) printf '%s\n' "$n" ;; esac
}

# ---------- pane inspection ----------
# cmm sessions run claude directly in a single pane. These helpers read that
# pane's screen to learn what claude is doing; they never type into it.

# The pane running claude in a session (falls back to the first pane).
_claude_pane() {
  local id cmd first=""
  while read -r id cmd; do
    [ -n "$first" ] || first="$id"
    case "$cmd" in claude|claude.exe|node) printf '%s\n' "$id"; return 0 ;; esac
  done < <(tmux list-panes -s -t "=$1" -F '#{pane_id} #{pane_current_command}' 2>/dev/null)
  printf '%s\n' "$first"
}

_pane_fmt()    { tmux display-message -p -t "$1" "$2" 2>/dev/null || true; }
_pane_dead()   { [ "$(_pane_fmt "$1" '#{pane_dead}')" = "1" ]; }

# Visible text of a pane, wrapped lines joined and trailing blank lines dropped
# (a detached pane can be taller than the screen claude last drew).
_pane_text() {
  tmux capture-pane -p -J -t "$1" 2>/dev/null \
    | awk '{ l[NR] = $0; if ($0 ~ /[^[:space:]]/) last = NR }
           END { for (i = 1; i <= last; i++) print l[i] }' || true
}
_pane_footer() { _pane_text "$1" | tail -n 10; }

# What claude in a pane is doing, judged from its screen:
#   busy    working on a turn ("esc to interrupt" in the footer)
#   empty   idle at an empty prompt
#   typing  idle, but there is unsent text in the prompt
#   dialog  waiting for an answer (trust prompt, resume prompt, /effort, ...)
#   none    no prompt visible (still starting, not claude, ...)
_pane_input_state() {
  case "$(_pane_footer "$1")" in *"esc to interrupt"*) printf 'busy\n'; return ;; esac
  _pane_prompt_scan "$1" | cut -f1
}

# The text a person has typed into the prompt (trimmed; empty if none).
_pane_prompt_typed() {
  _pane_prompt_scan "$1" | cut -f2-
}

# Read the input box with its colour codes and print "STATE<TAB>TYPED".
#
# The input box is a line starting with the prompt marker that sits directly
# under the box's top border, near the bottom of the screen. Both tests
# matter: claude leaves earlier prompts on screen as history, and a dialog
# (trust prompt, "resume from summary", a picker) is drawn *below* them, so
# picking the last marker line anywhere on screen reads a stale prompt and
# calls a session idle while it is really waiting for an answer.
#
# Placeholder hints and prompt suggestions are drawn dim (SGR 2); text the
# user typed is not, so only non-dim text counts as typed.
_pane_prompt_scan() {
  { tmux capture-pane -p -e -J -t "$1" 2>/dev/null || true; } | LC_ALL=C awk -v nb="$(printf '\302\240')" '
    {
      plain = $0; gsub(/\033\[[0-9;]*m/, "", plain)
      lines[NR] = $0; text[NR] = plain
      if (plain ~ /[^[:space:]]/) last = NR
    }
    END {
      raw = ""
      for (i = last; i > 0 && i > last - 12; i--) {
        if (text[i] ~ /^❯/ && i > 1 && text[i-1] ~ /^[[:space:]]*─/) { raw = lines[i]; break }
      }
      if (raw == "") {
        # No input box: either claude is waiting on a dialog or it is not up
        # yet. Dialogs put their marker in from the margin and spell out the
        # keys ("Esc to cancel", "Enter to select"); the prompt never does.
        for (i = last; i > 0 && i > last - 20; i--) {
          if (text[i] ~ /Esc to [a-z]/ || text[i] ~ /Enter to [a-z]/ ||
              text[i] ~ /^[[:space:]]+❯[[:space:]]/) { print "dialog\t"; exit }
        }
        print "none\t"; exit
      }
      sub(/^(\033\[[0-9;]*m)*❯/, "", raw)
      gsub(nb, " ", raw)
      dim = 0; typed = ""; s = raw
      while (length(s) > 0) {
        if (match(s, /\033\[[0-9;]*m/)) {
          if (!dim) typed = typed substr(s, 1, RSTART - 1)
          n = split(substr(s, RSTART + 2, RLENGTH - 3), p, ";")
          if (n == 0) dim = 0
          for (i = 1; i <= n; i++) {
            if (p[i] == "0" || p[i] == "22" || p[i] == "") dim = 0
            else if (p[i] == "2") dim = 1
          }
          s = substr(s, RSTART + RLENGTH)
        } else {
          if (!dim) typed = typed s
          s = ""
        }
      }
      sub(/^[ \t]+/, "", typed); sub(/[ \t]+$/, "", typed)
      print (typed == "" ? "empty" : "typing") "\t" typed
    }'
}

# Type a slash command into claude's prompt and submit it. Characters go one
# at a time (a burst can be taken for a paste and merged with a prompt
# suggestion), and Enter is only pressed once the prompt shows exactly the
# command. Returns 1 if the command could not be put into the prompt.
_type_command() {
  local pane="$1" cmd="$2" attempt i
  for attempt in 1 2; do
    for (( i = 0; i < ${#cmd}; i++ )); do
      tmux send-keys -l -t "$pane" "${cmd:i:1}"
      sleep 0.05
    done
    sleep 0.5
    if [ "$(_pane_prompt_typed "$pane")" = "$cmd" ]; then
      tmux send-keys -t "$pane" Enter
      return 0
    fi
    tmux send-keys -t "$pane" C-c   # clear whatever ended up there and try once more
    sleep 0.7
  done
  return 1
}

# Remote Control state shown in the footer: active|failed|reconnecting|connecting|off
_pane_rc_state() {
  case "$(_pane_footer "$1")" in
    *"/rc failed"*)         printf 'failed\n' ;;
    *"/rc reconnecting"*)   printf 'reconnecting\n' ;;
    *"/rc connecting"*)     printf 'connecting\n' ;;
    *"/rc active"*|*"/rc"*) printf 'active\n' ;;
    *)                      printf 'off\n' ;;
  esac
}

# True if claude's footer says a newer version is installed and waiting for a restart.
_pane_update_ready() {
  case "$(_pane_footer "$1")" in *"Restart to apply"*|*"Update installed"*) return 0 ;; esac
  return 1
}

# True if claude says Remote Control can only be retried after a restart.
_pane_rc_needs_restart() {
  case "$(_pane_text "$1" | tail -n 15)" in *"restart to retry"*) return 0 ;; esac
  return 1
}

# True if a client attached to the session has had keyboard activity within $2 seconds.
_session_recently_active() {
  local now t
  now=$(date +%s)
  while read -r t; do
    [ -n "$t" ] && [ $(( now - t )) -lt "$2" ] && return 0
  done < <(tmux list-clients -t "=$1" -F '#{client_activity}' 2>/dev/null)
  return 1
}

# True if the pane draws exactly the same screen $2 seconds apart, i.e. nothing
# is happening in it right now.
_pane_stable() {
  local before after
  before=$(_pane_text "$1")
  sleep "${2:-3}"
  after=$(_pane_text "$1")
  [ "$before" = "$after" ]
}

# Short status summary for `list`: state[,update-ready][,rc:...]
_pane_tags() {
  local pane="$1" tags rc
  [ -n "$pane" ] || { printf '?\n'; return; }
  if _pane_dead "$pane"; then printf 'exited\n'; return; fi
  case "$(_pane_input_state "$pane")" in
    busy)   tags="busy" ;;
    typing) tags="typing" ;;
    empty)  tags="idle" ;;
    dialog) tags="dialog" ;;
    *)      tags="no-prompt" ;;
  esac
  if _pane_update_ready "$pane"; then tags="$tags,update-ready"; fi
  rc=$(_pane_rc_state "$pane")
  case "$rc" in
    active) tags="$tags,rc:on" ;;
    *)      tags="$tags,rc:$rc" ;;
  esac
  printf '%s\n' "$tags"
}

# ---------- what a session was running ----------
# Restarting a session must not change the model or the effort level it was
# using. Claude does not carry either across a resume: /model saves the choice
# as the default for *new* sessions and /effort is explicitly session-only, so
# 'claude --resume' comes up on the global defaults. What a session was really
# running is in its transcript, and --model/--effort/--settings put it back.

# The transcript of a session id: $CLAUDE_DIR/projects/<dir>/<id>.jsonl
_transcript_for() {
  local id="$1" d
  case "$id" in ""|*[!0-9A-Fa-f-]*) return 0 ;; esac   # session ids only
  for d in "$CLAUDE_DIR"/projects/*/; do
    if [ -f "$d$id.jsonl" ]; then printf '%s\n' "$d$id.jsonl"; return 0; fi
  done
  return 0
}

# The conversation a *running* session is in, without disturbing it: the id
# cmm resumed it with, or else the newest transcript for its directory.
_session_id() {
  local name="$1" path="$2" id dir f
  id=$(_sess_get "$name" @cmm_session)
  if [ -n "$id" ]; then printf '%s\n' "$id"; return 0; fi
  dir="$CLAUDE_DIR/projects/$(printf '%s' "$path" | tr '/_.' '-')"
  [ -d "$dir" ] || return 0
  f=$(ls -t "$dir"/*.jsonl 2>/dev/null | head -n 1)
  [ -n "$f" ] || return 0
  f="${f##*/}"
  printf '%s\n' "${f%.jsonl}"
}

# Read a transcript and print what it says about the model and effort:
#   model       the model of the last reply claude made (ground truth)
#   alias       the argument of the last /model the user ran
#   effort      the level of the last /effort the user ran
#   *_line      where each was seen, so the newer of the two can win
# Local commands are recorded as user messages whose content starts with
# '<command-name>/model</command-name>', which is what the matches anchor on.
_transcript_scan() {
  [ -f "$1" ] || return 0
  LC_ALL=C awk '
    index($0, "\"message\":{\"role\":\"user\",\"content\":\"") {
      if (index($0, "<command-name>/effort</command-name>")) {
        if (match($0, /<command-args>[^<]*/)) {
          v = substr($0, RSTART + 14, RLENGTH - 14)
          sub(/[ \\].*/, "", v)
          if (v ~ /^(low|medium|med|high|xhigh|max|ultracode|auto)$/) effort = v
        }
        next
      }
      if (index($0, "<local-command-stdout>Set effort level to ")) {
        if (match($0, /Set effort level to [a-z]+/)) {
          v = substr($0, RSTART + 20, RLENGTH - 20)
          if (v ~ /^(low|medium|high|xhigh|max|ultracode|auto)$/) effort = v
        }
        next
      }
      if (index($0, "<command-name>/model</command-name>")) {
        if (match($0, /<command-args>[^<]*/)) {
          v = substr($0, RSTART + 14, RLENGTH - 14)
          sub(/[ \\].*/, "", v)
          if (v ~ /^(fable|opus|sonnet|haiku|default|claude-[A-Za-z0-9._-]+)$/) { alias = v; aline = NR }
        }
      }
      next
    }
    index($0, "\"message\":{\"model\":\"claude-") && index($0, "\"isSidechain\":false") {
      if (match($0, /"message":\{"model":"[^"]*"/)) {
        model = substr($0, RSTART + 20, RLENGTH - 21); mline = NR
      }
      next
    }
    # same thing for a reply whose keys come in another order
    index($0, "\"role\":\"assistant\"") && index($0, "\"model\":\"claude-") {
      if (match($0, /"model":"claude-[^"]*"/)) {
        loose = substr($0, RSTART + 9, RLENGTH - 10); lline = NR
      }
    }
    END {
      if (model == "") { model = loose; mline = lline }
      print "model=" model;  print "model_line=" mline
      print "alias=" alias;  print "alias_line=" aline
      print "effort=" effort
    }
  ' "$1" 2>/dev/null || true
}

# The family alias ('opus', 'fable', ...) behind a model name. Restoring the
# family rather than an exact version keeps a restarted session on a model this
# Claude Code still knows, however old the session is.
_model_alias() {
  case "$1" in
    *fable*)  printf 'fable\n' ;;
    *opus*)   printf 'opus\n' ;;
    *sonnet*) printf 'sonnet\n' ;;
    *haiku*)  printf 'haiku\n' ;;
    *)        printf '%s\n' "$1" ;;
  esac
}

# The claude arguments that put session $1 (resume id $2) back on the model and
# effort it was last using, one argument per line. Empty if nothing is known.
_restore_flags() {
  local name="$1" id="$2" file key val
  local model="" alias="" effort="" mline=0 aline=0 want=""
  file=$(_transcript_for "$id")
  if [ -n "$file" ]; then
    while IFS='=' read -r key val; do
      case "$key" in
        model)      model="$val" ;;
        model_line) mline="${val:-0}" ;;
        alias)      alias="$val" ;;
        alias_line) aline="${val:-0}" ;;
        effort)     effort="$val" ;;
      esac
    done < <(_transcript_scan "$file")
  fi

  # The model the user last asked for wins, unless a later reply shows they
  # have since switched to another family (with the picker, say).
  if [ -n "$alias" ] && { [ -z "$model" ] || [ "$aline" -gt "$mline" ] \
        || [ "$(_model_alias "$alias")" = "$(_model_alias "$model")" ]; }; then
    want=$(_model_alias "$alias")
  elif [ -n "$model" ]; then
    want=$(_model_alias "$model")
  fi
  # Fall back to what cmm launched the session with: an --effort given on the
  # command line leaves no trace in the transcript.
  [ -n "$want" ]   || want=$(_sess_get "$name" @cmm_model)
  [ -n "$effort" ] || effort=$(_sess_get "$name" @cmm_effort)

  [ -z "$want" ] || printf -- '--model\n%s\n' "$want"
  case "$effort" in
    ""|auto)             ;;
    ultracode)           printf -- '--settings\n{"ultracode":true}\n' ;;  # xhigh + workflows
    med|medium)          printf -- '--effort\nmedium\n' ;;
    low|high|xhigh|max)  printf -- '--effort\n%s\n' "$effort" ;;
  esac
}

# Note the model/effort a session was started with, on the session itself.
_remember_flags() {
  local name="$1" prev="" a
  shift
  for a in "$@"; do
    case "$prev" in
      --model)    _sess_set "$name" @cmm_model  "$a" ;;
      --effort)   _sess_set "$name" @cmm_effort "$a" ;;
      --settings) case "$a" in *'"ultracode":true'*) _sess_set "$name" @cmm_effort ultracode ;; esac ;;
    esac
    case "$a" in
      --model=*)  _sess_set "$name" @cmm_model  "${a#*=}" ;;
      --effort=*) _sess_set "$name" @cmm_effort "${a#*=}" ;;
    esac
    prev="$a"
  done
}

# One-line description of what would be restored, for 'list --model'.
_restore_summary() {
  local name="$1" id="$2" out="" prev="" a
  while IFS= read -r a; do
    case "$prev" in
      --model)    out="${out:+$out }$a" ;;
      --effort)   out="${out:+$out }$a effort" ;;
      --settings) case "$a" in *ultracode*) out="${out:+$out }ultracode" ;; esac ;;
    esac
    prev="$a"
  done < <(_restore_flags "$name" "$id")
  printf '%s\n' "${out:-defaults}"
}

# ---------- restart machinery ----------

# Set (or unset) remain-on-exit on a pane so it survives claude exiting.
_set_remain() {
  if [ "$2" = "unset" ]; then
    tmux set-option -p -t "$1" -u remain-on-exit 2>/dev/null \
      || tmux set-option -w -t "$1" -u remain-on-exit 2>/dev/null || true
  else
    tmux set-option -p -t "$1" remain-on-exit "$2" 2>/dev/null \
      || tmux set-option -w -t "$1" remain-on-exit "$2"
  fi
}

# Ask the claude in a pane to exit and wait up to $2 seconds for the pane to die.
# Escape closes any open menu (or interrupts a running turn), Ctrl-C clears
# unsent input, then /exit shuts claude down cleanly so it prints its resume hint.
_exit_claude() {
  local pane="$1" wait="${2:-30}" i=0
  tmux send-keys -t "$pane" Escape
  tmux send-keys -t "$pane" C-c
  sleep 0.5
  if ! _type_command "$pane" '/exit'; then
    # Could not get /exit into the prompt. Ctrl-C twice on an empty prompt
    # also shuts claude down cleanly (and prints the resume hint).
    tmux send-keys -t "$pane" C-c; sleep 0.4; tmux send-keys -t "$pane" C-c
  fi
  until _pane_dead "$pane"; do
    i=$(( i + 1 ))
    [ "$i" -lt "$wait" ] || return 1
    sleep 1
    [ $(( i % 4 )) -eq 0 ] || continue
    if [ "$(_pane_prompt_typed "$pane")" = "/exit" ]; then
      tmux send-keys -t "$pane" Enter               # Enter was swallowed; press it again
    elif [ "$i" -ge 8 ]; then
      case "$(_pane_input_state "$pane")" in
        busy)  tmux send-keys -t "$pane" Escape ;;  # something got submitted by accident; interrupt it
        empty) tmux send-keys -t "$pane" C-c; sleep 0.4; tmux send-keys -t "$pane" C-c ;;
      esac
    fi
  done
}

# Extract the argument of `--resume` from claude's exit hint:
#   Resume this session with:
#   claude [--worktree <name> ]--resume <session-id or "name">
_parse_resume_arg() {
  local line re_uuid re_name
  line=$(printf '%s\n' "$1" | LC_ALL=C grep -A2 -F 'Resume this session with:' \
         | LC_ALL=C grep -F -- '--resume' | tail -n 1) || true
  [ -n "$line" ] || return 0
  re_uuid='--resume[[:space:]]+([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})'
  re_name='--resume[[:space:]]+"((\\.|[^"\\])*)"'
  if [[ "$line" =~ $re_uuid ]]; then
    printf '%s\n' "${BASH_REMATCH[1]}"
  elif [[ "$line" =~ $re_name ]]; then
    printf '%s\n' "${BASH_REMATCH[1]}" | sed -e 's/\\\(.\)/\1/g'
  fi
}

# Extract the --worktree name from the exit hint, if claude printed one.
_parse_worktree() {
  local line re
  line=$(printf '%s\n' "$1" | LC_ALL=C grep -A2 -F 'Resume this session with:' \
         | LC_ALL=C grep -F -- '--resume' | tail -n 1) || true
  re='--worktree[[:space:]]+([A-Za-z0-9._/-]+)'
  if [[ "$line" =~ $re ]]; then printf '%s\n' "${BASH_REMATCH[1]}"; fi
}

# Restart claude in place inside session $1, resuming the same conversation.
# $2 = 1 to force (interrupt a busy claude / discard unsent input).
# Remaining arguments are passed to the new claude.
_restart_session() {
  local name="$1" force="$2"; shift 2
  local pane path state rc text arg wt line
  local -a cmd=() base=() restore=()
  pane=$(_claude_pane "$name")
  [ -n "$pane" ] || { warn "$name: no pane found"; return 1; }
  if [ "${TMUX_PANE:-}" = "$pane" ]; then
    warn "$name: this command is running inside that session's claude; run it from another tmux window or terminal"
    return 1
  fi
  path=$(_pane_fmt "$pane" '#{pane_current_path}')
  rc=$(_pane_rc_state "$pane")

  if _pane_dead "$pane"; then
    printf '%s: claude already exited; ' "$name"
  else
    state=$(_pane_input_state "$pane")
    if [ "$force" -ne 1 ]; then
      case "$state" in
        busy)   warn "$name: claude is working (esc to interrupt); skipped, use --force to interrupt it"; return 1 ;;
        typing) warn "$name: unsent text in the prompt; skipped, use --force to discard it"; return 1 ;;
        dialog) warn "$name: claude is waiting for an answer on screen; skipped, use --force to dismiss it"; return 1 ;;
        none)   warn "$name: claude is not at a prompt (still starting?); skipped, use --force"; return 1 ;;
      esac
    fi
    _set_remain "$pane" on
    printf '%s: stopping claude... ' "$name"
    if ! _exit_claude "$pane" 30; then
      printf 'no\n'
      _set_remain "$pane" unset
      warn "$name: claude did not exit within 30s; left running"
      return 1
    fi
  fi

  text=$(tmux capture-pane -p -J -t "$pane" -S -300 2>/dev/null || true)
  arg=$(_parse_resume_arg "$text")
  wt=$(_parse_worktree "$text")

  # Put the session back on the model and effort it was using.
  while IFS= read -r line; do
    if [ -n "$line" ]; then restore+=("$line"); fi
  done < <(_restore_flags "$name" "$arg")

  # 'env RESUME_PROMPT_OFF' keeps claude from offering to resume from a
  # summary: cmm's job here is to bring the whole conversation back.
  cmd=(env "$RESUME_PROMPT_OFF" claude)
  if [ -n "$wt" ]; then cmd+=(--worktree "$wt"); fi
  if [ -n "$arg" ]; then
    cmd+=(--resume "$arg")
  else
    warn "$name: no resume hint found on screen; using --continue (most recent conversation in $path)"
    cmd+=(--continue)
  fi
  base=("${cmd[@]}")
  if [ ${#restore[@]} -gt 0 ]; then cmd+=("${restore[@]}"); fi
  if [ $# -gt 0 ]; then cmd+=("$@"); base+=("$@"); fi   # explicit arguments win
  if [ "$rc" != "off" ]; then cmd+=(--remote-control); base+=(--remote-control); fi

  if ! _respawn_claude "$name" "$pane" "$path" "${cmd[@]}"; then
    if [ ${#restore[@]} -gt 0 ]; then
      # The likeliest reason is a model or setting this claude will not take.
      warn "$name: claude would not start with ${restore[*]}; retrying without it"
      if ! _respawn_claude "$name" "$pane" "$path" "${base[@]}"; then
        printf 'failed\n'
        warn "$name: claude exited right after restarting; the pane was kept so you can read why ('$PROG resume $name')"
        return 1
      fi
      restore=()
    else
      printf 'failed\n'
      warn "$name: claude exited right after restarting; the pane was kept so you can read why ('$PROG resume $name')"
      return 1
    fi
  fi

  _sess_set "$name" @cmm_last_restart "$(date +%s)"
  if [ -n "$arg" ]; then _sess_set "$name" @cmm_session "$arg"; fi
  _remember_flags "$name" "${cmd[@]}"
  printf 'restarted (resumed %s%s)\n' "${arg:-most recent conversation}" \
    "$( [ ${#restore[@]} -gt 0 ] && printf ', kept %s' "$(_restore_summary "$name" "$arg")" )"
}

# Start a claude command line in a pane and wait for it to come up. The pane is
# kept when claude dies so the error stays readable; returns 1 in that case.
_respawn_claude() {
  local name="$1" pane="$2" path="$3"; shift 3
  local i=0 state=""
  _set_remain "$pane" on
  tmux respawn-pane -k -t "$pane" -c "$path" "$(_shell_join "$@")"
  while [ "$i" -lt 15 ]; do
    if _pane_dead "$pane"; then return 1; fi
    state=$(_pane_input_state "$pane")
    case "$state" in empty|typing|busy) break ;; esac
    sleep 1; i=$(( i + 1 ))
  done
  _set_remain "$pane" unset
  if _pane_dead "$pane"; then return 1; fi
  if [ "$state" = "dialog" ]; then
    warn "$name: claude is asking something on the way up; answer it with '$PROG resume $name'"
  fi
  return 0
}

