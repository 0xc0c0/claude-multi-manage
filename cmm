#!/usr/bin/env bash
# cmm - claude-multi-manage
# Start and manage multiple `claude` sessions on one host via tmux.

set -euo pipefail

VERSION="0.5.0"
PROG="$(basename "${0}")"
SESSION_PREFIX="claude-"
MAINT_SESSION="cmm-maintain"
LEGACY_SESSION="cmm-keepalive"   # what the daemon was called before 0.4.0
STATE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/cmm"
MAINT_LOG="$STATE_DIR/maintain.log"
# Where `pause` keeps what `reload` needs to bring sessions back after a
# reboot. Not under STATE_DIR: a cache directory makes no promise to survive one.
PAUSE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/cmm/paused"
LOG_MAX_BYTES=$(( 1024 * 1024 ))
CLAUDE_DIR="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
# Claude offers to resume long sessions "from a summary"; that prompt would
# block an unattended restart and throw away the context cmm is preserving.
# Its threshold is an env var, so a big one turns the prompt off.
RESUME_PROMPT_OFF="CLAUDE_CODE_RESUME_THRESHOLD_MINUTES=999999999"

# ---------- helpers ----------

die()  { printf 'error: %s\n' "$*" >&2; exit 1; }
warn() { printf 'warning: %s\n' "$*" >&2; }
log()  {
  local line
  line="[$(date '+%Y-%m-%d %H:%M:%S')] $*"
  printf '%s\n' "$line"
  if [ -n "${CMM_LOG:-}" ]; then printf '%s\n' "$line" >> "$CMM_LOG" 2>/dev/null || true; fi
}

need() {
  command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"
}

# Resolve the real path to this script (used by `install` and `keepalive --daemon`).
_self_path() {
  local src="${BASH_SOURCE[0]}" dir
  while [ -h "$src" ]; do
    dir="$(cd -P "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    [[ $src != /* ]] && src="$dir/$src"
  done
  cd -P "$(dirname "$src")" && printf '%s/%s\n' "$(pwd)" "$(basename "$src")"
}

_human_age() {
  local now then secs
  now=$(date +%s); then=$1; secs=$(( now - then ))
  if   (( secs <    60 )); then printf '%ds ago' "$secs"
  elif (( secs <  3600 )); then printf '%dm ago' $(( secs /    60 ))
  elif (( secs < 86400 )); then printf '%dh ago' $(( secs /  3600 ))
  else                          printf '%dd ago' $(( secs / 86400 ))
  fi
}

# Quote arguments for a POSIX shell. tmux runs pane commands through the
# user's shell, so every argument we hand it must be quoted.
_shell_join() {
  local out="" a q="'"
  for a in "$@"; do
    a="$q${a//$q/$q\\$q$q}$q"
    out="${out:+$out }$a"
  done
  printf '%s' "$out"
}

# Only one thing may drive sessions on this host at a time, so a maintenance
# pass can never collide with a second pass or with an interactive update.
# $1 = seconds to wait for the lock (0 = give up immediately).
_lock_acquire() {
  local wait="${1:-0}" i=0 owner age
  mkdir -p "$STATE_DIR" 2>/dev/null || true
  while :; do
    if mkdir "$STATE_DIR/lock" 2>/dev/null; then
      printf '%s %s\n' "$$" "$(date +%s)" > "$STATE_DIR/lock/owner" 2>/dev/null || true
      CMM_LOCKED=1
      trap _lock_release EXIT INT TERM
      return 0
    fi
    # break a lock left behind by a run that died (nothing here takes an hour)
    owner=$(cat "$STATE_DIR/lock/owner" 2>/dev/null) || owner=""
    age=$(printf '%s' "$owner" | awk '{print $2}')
    if [ -n "$age" ] && [ $(( $(date +%s) - age )) -gt 3600 ]; then
      warn "removing a stale lock from $(printf '%s' "$owner" | awk '{print $1}')"
      rm -rf "$STATE_DIR/lock" 2>/dev/null || true
      continue
    fi
    [ "$i" -lt "$wait" ] || return 1
    i=$(( i + 1 )); sleep 1
  done
}

_lock_release() {
  [ "${CMM_LOCKED:-0}" = "1" ] || return 0
  CMM_LOCKED=0
  rm -rf "$STATE_DIR/lock" 2>/dev/null || true
}

# Session-scoped notes cmm keeps for itself, as tmux user options: they live
# and die with the session and need no state file. (set-option/show-options
# do not take the '=' exact-match prefix, but session names are exact anyway.)
_sess_get() { tmux show-options -v -t "$1" "$2" 2>/dev/null || true; }
_sess_set() { tmux set-option -t "$1" "$2" "$3" >/dev/null 2>&1 || true; }

# Print "NAME|ATTACHED|CREATED_EPOCH|PATH" for matching sessions, one per line.
# scope = "here" (under $PWD) or "all".
#
# The separator is '|' and the path comes last on purpose: without a UTF-8
# locale (in a cron job, say) tmux rewrites unprintable characters in -F output,
# turning a tab separator into '_', and a path is the only field that could
# contain the separator itself.
_collect_sessions() {
  local scope="$1"
  tmux list-sessions \
    -F '#{session_name}|#{session_attached}|#{session_created}|#{session_path}' \
    2>/dev/null \
    | awk -v prefix="$SESSION_PREFIX" -v here="$PWD" -v scope="$scope" '
        index($0, prefix) == 1 {
          path = $0
          sub(/^[^|]*\|[^|]*\|[^|]*\|/, "", path)
          if (scope == "all") { print; next }
          if (path == here || index(path, here "/") == 1) print
        }'
}

# Attach to a session; switch-client if we are already inside tmux.
_attach() {
  if [ -n "${TMUX:-}" ]; then
    tmux switch-client -t "$1"
  else
    tmux attach -t "$1"
  fi
}

# Resolve a session reference (list #, full name, or name without the
# 'claude-' prefix) to a tmux session name. Dies if nothing matches.
_resolve_session() {
  local arg="$1" rows target=""
  if [[ "$arg" =~ ^[0-9]+$ ]]; then
    rows=$(_collect_sessions "here") || true
    target=$(awk -F'[|]' -v n="$arg" 'NR==n {print $1; exit}' <<< "$rows")
    [ -n "$target" ] || die "no session #$arg in list (under $PWD)"
  elif tmux has-session -t "=$arg" 2>/dev/null; then
    target="$arg"
  elif tmux has-session -t "=${SESSION_PREFIX}${arg}" 2>/dev/null; then
    target="${SESSION_PREFIX}${arg}"
  else
    die "no session matches: $arg"
  fi
  printf '%s\n' "$target"
}

# Show the list under $PWD and let the user pick one; prints the session name.
_pick_session() {
  local rows arg
  rows=$(_collect_sessions "here") || true
  [ -n "$rows" ] || die "no claude sessions under $PWD (try '$PROG new' or '$PROG list --all')"
  cmd_list >&2
  printf '\nselect # (or name): ' >&2
  read -r arg || die "no selection"
  [ -n "$arg" ] || die "no selection"
  _resolve_session "$arg"
}

# The cmm session this command is running inside, if any.
_current_session() {
  local n
  [ -n "${TMUX:-}" ] || return 0
  n=$(tmux display-message -p '#{session_name}' 2>/dev/null) || return 0
  case "$n" in "$SESSION_PREFIX"*) printf '%s\n' "$n" ;; esac
}

# ---------- pane inspection ----------
# cmm sessions run claude directly in a single pane. These helpers read that
# pane's screen to learn what claude is doing; they never type into it.

# The pane running claude in a session (falls back to the first pane).
_claude_pane() {
  local id cmd first=""
  while read -r id cmd; do
    [ -n "$first" ] || first="$id"
    case "$cmd" in claude|claude.exe|node) printf '%s\n' "$id"; return 0 ;; esac
  done < <(tmux list-panes -s -t "=$1" -F '#{pane_id} #{pane_current_command}' 2>/dev/null)
  printf '%s\n' "$first"
}

_pane_fmt()    { tmux display-message -p -t "$1" "$2" 2>/dev/null || true; }
_pane_dead()   { [ "$(_pane_fmt "$1" '#{pane_dead}')" = "1" ]; }

# Visible text of a pane, wrapped lines joined and trailing blank lines dropped
# (a detached pane can be taller than the screen claude last drew).
_pane_text() {
  tmux capture-pane -p -J -t "$1" 2>/dev/null \
    | awk '{ l[NR] = $0; if ($0 ~ /[^[:space:]]/) last = NR }
           END { for (i = 1; i <= last; i++) print l[i] }' || true
}
_pane_footer() { _pane_text "$1" | tail -n 10; }

# What claude in a pane is doing, judged from its screen:
#   busy    working on a turn ("esc to interrupt" in the footer)
#   empty   idle at an empty prompt
#   typing  idle, but there is unsent text in the prompt
#   dialog  waiting for an answer (trust prompt, resume prompt, /effort, ...)
#   none    no prompt visible (still starting, not claude, ...)
_pane_input_state() {
  case "$(_pane_footer "$1")" in *"esc to interrupt"*) printf 'busy\n'; return ;; esac
  _pane_prompt_scan "$1" | cut -f1
}

# The text a person has typed into the prompt (trimmed; empty if none).
_pane_prompt_typed() {
  _pane_prompt_scan "$1" | cut -f2-
}

# Read the input box with its colour codes and print "STATE<TAB>TYPED".
#
# The input box is a line starting with the prompt marker that sits directly
# under the box's top border, near the bottom of the screen. Both tests
# matter: claude leaves earlier prompts on screen as history, and a dialog
# (trust prompt, "resume from summary", a picker) is drawn *below* them, so
# picking the last marker line anywhere on screen reads a stale prompt and
# calls a session idle while it is really waiting for an answer.
#
# Placeholder hints and prompt suggestions are drawn dim (SGR 2); text the
# user typed is not, so only non-dim text counts as typed.
_pane_prompt_scan() {
  { tmux capture-pane -p -e -J -t "$1" 2>/dev/null || true; } | LC_ALL=C awk -v nb="$(printf '\302\240')" '
    {
      plain = $0; gsub(/\033\[[0-9;]*m/, "", plain)
      lines[NR] = $0; text[NR] = plain
      if (plain ~ /[^[:space:]]/) last = NR
    }
    END {
      raw = ""
      for (i = last; i > 0 && i > last - 12; i--) {
        if (text[i] ~ /^❯/ && i > 1 && text[i-1] ~ /^[[:space:]]*─/) { raw = lines[i]; break }
      }
      if (raw == "") {
        # No input box: either claude is waiting on a dialog or it is not up
        # yet. Dialogs put their marker in from the margin and spell out the
        # keys ("Esc to cancel", "Enter to select"); the prompt never does.
        for (i = last; i > 0 && i > last - 20; i--) {
          if (text[i] ~ /Esc to [a-z]/ || text[i] ~ /Enter to [a-z]/ ||
              text[i] ~ /^[[:space:]]+❯[[:space:]]/) { print "dialog\t"; exit }
        }
        print "none\t"; exit
      }
      sub(/^(\033\[[0-9;]*m)*❯/, "", raw)
      gsub(nb, " ", raw)
      dim = 0; typed = ""; s = raw
      while (length(s) > 0) {
        if (match(s, /\033\[[0-9;]*m/)) {
          if (!dim) typed = typed substr(s, 1, RSTART - 1)
          n = split(substr(s, RSTART + 2, RLENGTH - 3), p, ";")
          if (n == 0) dim = 0
          for (i = 1; i <= n; i++) {
            if (p[i] == "0" || p[i] == "22" || p[i] == "") dim = 0
            else if (p[i] == "2") dim = 1
          }
          s = substr(s, RSTART + RLENGTH)
        } else {
          if (!dim) typed = typed s
          s = ""
        }
      }
      sub(/^[ \t]+/, "", typed); sub(/[ \t]+$/, "", typed)
      print (typed == "" ? "empty" : "typing") "\t" typed
    }'
}

# Type a slash command into claude's prompt and submit it. Characters go one
# at a time (a burst can be taken for a paste and merged with a prompt
# suggestion), and Enter is only pressed once the prompt shows exactly the
# command. Returns 1 if the command could not be put into the prompt.
_type_command() {
  local pane="$1" cmd="$2" attempt i
  for attempt in 1 2; do
    for (( i = 0; i < ${#cmd}; i++ )); do
      tmux send-keys -l -t "$pane" "${cmd:i:1}"
      sleep 0.05
    done
    sleep 0.5
    if [ "$(_pane_prompt_typed "$pane")" = "$cmd" ]; then
      tmux send-keys -t "$pane" Enter
      return 0
    fi
    tmux send-keys -t "$pane" C-c   # clear whatever ended up there and try once more
    sleep 0.7
  done
  return 1
}

# Remote Control state shown in the footer: active|failed|reconnecting|connecting|off
_pane_rc_state() {
  case "$(_pane_footer "$1")" in
    *"/rc failed"*)         printf 'failed\n' ;;
    *"/rc reconnecting"*)   printf 'reconnecting\n' ;;
    *"/rc connecting"*)     printf 'connecting\n' ;;
    *"/rc active"*|*"/rc"*) printf 'active\n' ;;
    *)                      printf 'off\n' ;;
  esac
}

# True if claude's footer says a newer version is installed and waiting for a restart.
_pane_update_ready() {
  case "$(_pane_footer "$1")" in *"Restart to apply"*|*"Update installed"*) return 0 ;; esac
  return 1
}

# True if claude says Remote Control can only be retried after a restart.
_pane_rc_needs_restart() {
  case "$(_pane_text "$1" | tail -n 15)" in *"restart to retry"*) return 0 ;; esac
  return 1
}

# True if a client attached to the session has had keyboard activity within $2 seconds.
_session_recently_active() {
  local now t
  now=$(date +%s)
  while read -r t; do
    [ -n "$t" ] && [ $(( now - t )) -lt "$2" ] && return 0
  done < <(tmux list-clients -t "=$1" -F '#{client_activity}' 2>/dev/null)
  return 1
}

# True if the pane draws exactly the same screen $2 seconds apart, i.e. nothing
# is happening in it right now.
_pane_stable() {
  local before after
  before=$(_pane_text "$1")
  sleep "${2:-3}"
  after=$(_pane_text "$1")
  [ "$before" = "$after" ]
}

# Short status summary for `list`: state[,update-ready][,rc:...]
_pane_tags() {
  local pane="$1" tags rc
  [ -n "$pane" ] || { printf '?\n'; return; }
  if _pane_dead "$pane"; then printf 'exited\n'; return; fi
  case "$(_pane_input_state "$pane")" in
    busy)   tags="busy" ;;
    typing) tags="typing" ;;
    empty)  tags="idle" ;;
    dialog) tags="dialog" ;;
    *)      tags="no-prompt" ;;
  esac
  if _pane_update_ready "$pane"; then tags="$tags,update-ready"; fi
  rc=$(_pane_rc_state "$pane")
  case "$rc" in
    active) tags="$tags,rc:on" ;;
    *)      tags="$tags,rc:$rc" ;;
  esac
  printf '%s\n' "$tags"
}

# ---------- what a session was running ----------
# Restarting a session must not change the model or the effort level it was
# using. Claude does not carry either across a resume: /model saves the choice
# as the default for *new* sessions and /effort is explicitly session-only, so
# 'claude --resume' comes up on the global defaults. What a session was really
# running is in its transcript, and --model/--effort/--settings put it back.

# The transcript of a session id: $CLAUDE_DIR/projects/<dir>/<id>.jsonl
_transcript_for() {
  local id="$1" d
  case "$id" in ""|*[!0-9A-Fa-f-]*) return 0 ;; esac   # session ids only
  for d in "$CLAUDE_DIR"/projects/*/; do
    if [ -f "$d$id.jsonl" ]; then printf '%s\n' "$d$id.jsonl"; return 0; fi
  done
  return 0
}

# The conversation a *running* session is in, without disturbing it: the id
# cmm resumed it with, or else the newest transcript for its directory.
_session_id() {
  local name="$1" path="$2" maxage="${3:-}" id dir f
  id=$(_sess_get "$name" @cmm_session)
  if [ -n "$id" ]; then printf '%s\n' "$id"; return 0; fi
  [ "$maxage" != "0" ] || return 0            # 0: trust nothing but cmm's own note
  dir="$CLAUDE_DIR/projects/$(printf '%s' "$path" | tr '/_.' '-')"
  [ -d "$dir" ] || return 0
  f=$(ls -t "$dir"/*.jsonl 2>/dev/null | head -n 1)
  [ -n "$f" ] || return 0
  # With a maximum age, only a transcript written that recently counts.
  if [ -n "$maxage" ] && [ $(( $(date +%s) - $(date -r "$f" +%s) )) -gt "$maxage" ]; then return 0; fi
  f="${f##*/}"
  printf '%s\n' "${f%.jsonl}"
}

# Read a transcript and print what it says about the model and effort:
#   model       the model of the last reply claude made (ground truth)
#   alias       the argument of the last /model the user ran
#   effort      the level of the last /effort the user ran
#   *_line      where each was seen, so the newer of the two can win
# Local commands are recorded as user messages whose content starts with
# '<command-name>/model</command-name>', which is what the matches anchor on.
_transcript_scan() {
  [ -f "$1" ] || return 0
  LC_ALL=C awk '
    index($0, "\"message\":{\"role\":\"user\",\"content\":\"") {
      if (index($0, "<command-name>/effort</command-name>")) {
        if (match($0, /<command-args>[^<]*/)) {
          v = substr($0, RSTART + 14, RLENGTH - 14)
          sub(/[ \\].*/, "", v)
          if (v ~ /^(low|medium|med|high|xhigh|max|ultracode|auto)$/) effort = v
        }
        next
      }
      if (index($0, "<local-command-stdout>Set effort level to ")) {
        if (match($0, /Set effort level to [a-z]+/)) {
          v = substr($0, RSTART + 20, RLENGTH - 20)
          if (v ~ /^(low|medium|high|xhigh|max|ultracode|auto)$/) effort = v
        }
        next
      }
      if (index($0, "<command-name>/model</command-name>")) {
        if (match($0, /<command-args>[^<]*/)) {
          v = substr($0, RSTART + 14, RLENGTH - 14)
          sub(/[ \\].*/, "", v)
          if (v ~ /^(fable|opus|sonnet|haiku|default|claude-[A-Za-z0-9._-]+)$/) { alias = v; aline = NR }
        }
      }
      next
    }
    index($0, "\"message\":{\"model\":\"claude-") && index($0, "\"isSidechain\":false") {
      if (match($0, /"message":\{"model":"[^"]*"/)) {
        model = substr($0, RSTART + 20, RLENGTH - 21); mline = NR
      }
      next
    }
    # same thing for a reply whose keys come in another order
    index($0, "\"role\":\"assistant\"") && index($0, "\"model\":\"claude-") {
      if (match($0, /"model":"claude-[^"]*"/)) {
        loose = substr($0, RSTART + 9, RLENGTH - 10); lline = NR
      }
    }
    END {
      if (model == "") { model = loose; mline = lline }
      print "model=" model;  print "model_line=" mline
      print "alias=" alias;  print "alias_line=" aline
      print "effort=" effort
    }
  ' "$1" 2>/dev/null || true
}

# The family alias ('opus', 'fable', ...) behind a model name. Restoring the
# family rather than an exact version keeps a restarted session on a model this
# Claude Code still knows, however old the session is.
_model_alias() {
  case "$1" in
    *fable*)  printf 'fable\n' ;;
    *opus*)   printf 'opus\n' ;;
    *sonnet*) printf 'sonnet\n' ;;
    *haiku*)  printf 'haiku\n' ;;
    *)        printf '%s\n' "$1" ;;
  esac
}

# The claude arguments that put session $1 (resume id $2) back on the model and
# effort it was last using, one argument per line. Empty if nothing is known.
# The model and effort session $1 (resume id $2) was last using, as two
# lines: the model's family alias, then the effort level (either may be empty).
_restore_pick() {
  local name="$1" id="$2" file key val
  local model="" alias="" effort="" mline=0 aline=0 want=""
  file=$(_transcript_for "$id")
  if [ -n "$file" ]; then
    while IFS='=' read -r key val; do
      case "$key" in
        model)      model="$val" ;;
        model_line) mline="${val:-0}" ;;
        alias)      alias="$val" ;;
        alias_line) aline="${val:-0}" ;;
        effort)     effort="$val" ;;
      esac
    done < <(_transcript_scan "$file")
  fi

  # The model the user last asked for wins, unless a later reply shows they
  # have since switched to another family (with the picker, say).
  if [ -n "$alias" ] && { [ -z "$model" ] || [ "$aline" -gt "$mline" ] \
        || [ "$(_model_alias "$alias")" = "$(_model_alias "$model")" ]; }; then
    want=$(_model_alias "$alias")
  elif [ -n "$model" ]; then
    want=$(_model_alias "$model")
  fi
  # Fall back to what cmm launched the session with: an --effort given on the
  # command line leaves no trace in the transcript.
  [ -n "$want" ]   || want=$(_sess_get "$name" @cmm_model)
  [ -n "$effort" ] || effort=$(_sess_get "$name" @cmm_effort)
  printf '%s\n%s\n' "$want" "$effort"
}

# The claude arguments for model $1 and effort $2, one per line.
_flags_for() {
  [ -z "$1" ] || printf -- '--model\n%s\n' "$1"
  case "$2" in
    ""|auto)             ;;
    ultracode)           printf -- '--settings\n{"ultracode":true}\n' ;;  # xhigh + workflows
    med|medium)          printf -- '--effort\nmedium\n' ;;
    low|high|xhigh|max)  printf -- '--effort\n%s\n' "$2" ;;
  esac
}

# The claude arguments that put session $1 (resume id $2) back on the model and
# effort it was last using, one argument per line. Empty if nothing is known.
_restore_flags() {
  local model effort
  { read -r model; read -r effort; } < <(_restore_pick "$1" "$2")
  _flags_for "$model" "$effort"
}

# Note the model/effort a session was started with, on the session itself.
_remember_flags() {
  local name="$1" prev="" a
  shift
  for a in "$@"; do
    case "$prev" in
      --model)    _sess_set "$name" @cmm_model  "$a" ;;
      --effort)   _sess_set "$name" @cmm_effort "$a" ;;
      --settings) case "$a" in *'"ultracode":true'*) _sess_set "$name" @cmm_effort ultracode ;; esac ;;
    esac
    case "$a" in
      --model=*)  _sess_set "$name" @cmm_model  "${a#*=}" ;;
      --effort=*) _sess_set "$name" @cmm_effort "${a#*=}" ;;
    esac
    prev="$a"
  done
}

# One-line description of what would be restored, for 'list --model'.
# One-line description of model $1 and effort $2, for 'list --model' and the
# restart messages: "opus max effort", "ultracode", "defaults", ...
_kept_summary() {
  local out="$1"
  case "$2" in
    ultracode)           out="${out:+$out }ultracode" ;;
    med|medium)          out="${out:+$out }medium effort" ;;
    low|high|xhigh|max)  out="${out:+$out }$2 effort" ;;
  esac
  printf '%s\n' "${out:-defaults}"
}

# The same for what a restart of session $1 (resume id $2) would keep.
_restore_summary() {
  local model effort
  { read -r model; read -r effort; } < <(_restore_pick "$1" "$2")
  _kept_summary "$model" "$effort"
}

# ---------- restart machinery ----------

# Set (or unset) remain-on-exit on a pane so it survives claude exiting.
_set_remain() {
  if [ "$2" = "unset" ]; then
    tmux set-option -p -t "$1" -u remain-on-exit 2>/dev/null \
      || tmux set-option -w -t "$1" -u remain-on-exit 2>/dev/null || true
  else
    tmux set-option -p -t "$1" remain-on-exit "$2" 2>/dev/null \
      || tmux set-option -w -t "$1" remain-on-exit "$2"
  fi
}

# Ask the claude in a pane to exit and wait up to $2 seconds for the pane to die.
# Escape closes any open menu (or interrupts a running turn), Ctrl-C clears
# unsent input, then /exit shuts claude down cleanly so it prints its resume hint.
_exit_claude() {
  local pane="$1" wait="${2:-30}" i=0
  tmux send-keys -t "$pane" Escape
  tmux send-keys -t "$pane" C-c
  sleep 0.5
  if ! _type_command "$pane" '/exit'; then
    # Could not get /exit into the prompt. Ctrl-C twice on an empty prompt
    # also shuts claude down cleanly (and prints the resume hint).
    tmux send-keys -t "$pane" C-c; sleep 0.4; tmux send-keys -t "$pane" C-c
  fi
  until _pane_dead "$pane"; do
    i=$(( i + 1 ))
    [ "$i" -lt "$wait" ] || return 1
    sleep 1
    [ $(( i % 4 )) -eq 0 ] || continue
    if [ "$(_pane_prompt_typed "$pane")" = "/exit" ]; then
      tmux send-keys -t "$pane" Enter               # Enter was swallowed; press it again
    elif [ "$i" -ge 8 ]; then
      case "$(_pane_input_state "$pane")" in
        busy)  tmux send-keys -t "$pane" Escape ;;  # something got submitted by accident; interrupt it
        empty) tmux send-keys -t "$pane" C-c; sleep 0.4; tmux send-keys -t "$pane" C-c ;;
      esac
    fi
  done
}

# Extract the argument of `--resume` from claude's exit hint:
#   Resume this session with:
#   claude [--worktree <name> ]--resume <session-id or "name">
_parse_resume_arg() {
  local line re_uuid re_name
  line=$(printf '%s\n' "$1" | LC_ALL=C grep -A2 -F 'Resume this session with:' \
         | LC_ALL=C grep -F -- '--resume' | tail -n 1) || true
  [ -n "$line" ] || return 0
  re_uuid='--resume[[:space:]]+([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})'
  re_name='--resume[[:space:]]+"((\\.|[^"\\])*)"'
  if [[ "$line" =~ $re_uuid ]]; then
    printf '%s\n' "${BASH_REMATCH[1]}"
  elif [[ "$line" =~ $re_name ]]; then
    printf '%s\n' "${BASH_REMATCH[1]}" | sed -e 's/\\\(.\)/\1/g'
  fi
}

# Extract the --worktree name from the exit hint, if claude printed one.
_parse_worktree() {
  local line re
  line=$(printf '%s\n' "$1" | LC_ALL=C grep -A2 -F 'Resume this session with:' \
         | LC_ALL=C grep -F -- '--resume' | tail -n 1) || true
  re='--worktree[[:space:]]+([A-Za-z0-9._/-]+)'
  if [[ "$line" =~ $re ]]; then printf '%s\n' "${BASH_REMATCH[1]}"; fi
}

# Restart claude in place inside session $1, resuming the same conversation.
# $2 = 1 to force (interrupt a busy claude / discard unsent input).
# Remaining arguments are passed to the new claude.
# Restart claude in place inside session $1, resuming the same conversation.
# $2 = 1 to force (interrupt a busy claude / discard unsent input).
# Remaining arguments are passed to the new claude.
_restart_session() {
  local name="$1" force="$2"; shift 2
  local pane path state rc text arg wt model effort
  pane=$(_claude_pane "$name")
  [ -n "$pane" ] || { warn "$name: no pane found"; return 1; }
  if [ "${TMUX_PANE:-}" = "$pane" ]; then
    warn "$name: this command is running inside that session's claude; run it from another tmux window or terminal"
    return 1
  fi
  path=$(_pane_fmt "$pane" '#{pane_current_path}')
  rc=$(_pane_rc_state "$pane")

  if _pane_dead "$pane"; then
    printf '%s: claude already exited; ' "$name"
  else
    state=$(_pane_input_state "$pane")
    if [ "$force" -ne 1 ]; then
      case "$state" in
        busy)   warn "$name: claude is working (esc to interrupt); skipped, use --force to interrupt it"; return 1 ;;
        typing) warn "$name: unsent text in the prompt; skipped, use --force to discard it"; return 1 ;;
        dialog) warn "$name: claude is waiting for an answer on screen; skipped, use --force to dismiss it"; return 1 ;;
        none)   warn "$name: claude is not at a prompt (still starting?); skipped, use --force"; return 1 ;;
      esac
    fi
    _set_remain "$pane" on
    printf '%s: stopping claude... ' "$name"
    if ! _exit_claude "$pane" 30; then
      printf 'no\n'
      _set_remain "$pane" unset
      warn "$name: claude did not exit within 30s; left running"
      return 1
    fi
  fi

  text=$(tmux capture-pane -p -J -t "$pane" -S -300 2>/dev/null || true)
  arg=$(_parse_resume_arg "$text")
  wt=$(_parse_worktree "$text")
  if [ -z "$arg" ]; then
    warn "$name: no resume hint found on screen; using --continue (most recent conversation in $path)"
  fi
  { read -r model; read -r effort; } < <(_restore_pick "$name" "$arg")
  _bring_up "$name" "$pane" "$path" "${arg:---continue}" "$wt" "$rc" "$model" "$effort" "$@" || return 1
  printf 'restarted %s\n' "$CAME_BACK"
}

# Start claude in pane $2 of session $1, in directory $3. $4 says which
# conversation: a resume id, '--continue' for the most recent one in that
# directory, or empty for a new one. $5 is a worktree name, Remote Control
# is turned on unless $6 is 'off', and $7/$8 are the model and effort to put
# back. Any further arguments go to claude and win over the restored ones.
# Sets CAME_BACK to a description of what came back; prints 'failed' and
# returns 1 if claude would not start (the pane is kept so the error stays
# readable).
CAME_BACK=""
_bring_up() {
  local name="$1" pane="$2" path="$3" which="$4" wt="$5" rc="$6" model="$7" effort="$8"; shift 8
  local line
  local -a cmd=() base=() restore=()
  while IFS= read -r line; do
    [ -z "$line" ] || restore+=("$line")
  done < <(_flags_for "$model" "$effort")

  # 'env RESUME_PROMPT_OFF' keeps claude from offering to resume from a
  # summary: cmm's job here is to bring the whole conversation back.
  cmd=(env "$RESUME_PROMPT_OFF" claude)
  if [ -n "$wt" ]; then cmd+=(--worktree "$wt"); fi
  case "$which" in
    "")         ;;
    --continue) cmd+=(--continue) ;;
    *)          cmd+=(--resume "$which") ;;
  esac
  base=("${cmd[@]}")
  if [ ${#restore[@]} -gt 0 ]; then cmd+=("${restore[@]}"); fi
  if [ $# -gt 0 ]; then cmd+=("$@"); base+=("$@"); fi   # explicit arguments win
  if [ "$rc" != "off" ]; then cmd+=(--remote-control); base+=(--remote-control); fi

  if ! _respawn_claude "$name" "$pane" "$path" "${cmd[@]}"; then
    if [ ${#restore[@]} -eq 0 ]; then
      printf 'failed\n'
      warn "$name: claude exited right after starting; the pane was kept so you can read why ('$PROG resume $name')"
      return 1
    fi
    # The likeliest reason is a model or setting this claude will not take.
    warn "$name: claude would not start with ${restore[*]}; retrying without it"
    if ! _respawn_claude "$name" "$pane" "$path" "${base[@]}"; then
      printf 'failed\n'
      warn "$name: claude exited right after starting; the pane was kept so you can read why ('$PROG resume $name')"
      return 1
    fi
    cmd=("${base[@]}"); restore=(); model=""; effort=""
  fi

  _sess_set "$name" @cmm_last_restart "$(date +%s)"
  case "$which" in ""|--continue) ;; *) _sess_set "$name" @cmm_session "$which" ;; esac
  _remember_flags "$name" "${cmd[@]}"
  case "$which" in
    "")         CAME_BACK="(new conversation" ;;
    --continue) CAME_BACK="(resumed most recent conversation" ;;
    *)          CAME_BACK="(resumed $which" ;;
  esac
  if [ ${#restore[@]} -gt 0 ]; then CAME_BACK="$CAME_BACK, kept $(_kept_summary "$model" "$effort")"; fi
  CAME_BACK="$CAME_BACK)"
}

# Start a claude command line in a pane and wait for it to come up. The pane is
# kept when claude dies so the error stays readable; returns 1 in that case.
_respawn_claude() {
  local name="$1" pane="$2" path="$3"; shift 3
  local i=0 state=""
  _set_remain "$pane" on
  tmux respawn-pane -k -t "$pane" -c "$path" "$(_shell_join "$@")"
  while [ "$i" -lt 15 ]; do
    if _pane_dead "$pane"; then return 1; fi
    state=$(_pane_input_state "$pane")
    case "$state" in empty|typing|busy) break ;; esac
    sleep 1; i=$(( i + 1 ))
  done
  _set_remain "$pane" unset
  if _pane_dead "$pane"; then return 1; fi
  if [ "$state" = "dialog" ]; then
    warn "$name: claude is asking something on the way up; answer it with '$PROG resume $name'"
  fi
  return 0
}

# ---------- help ----------

usage() {
  cat <<EOF
$PROG $VERSION - manage multiple claude sessions via tmux

USAGE:
  $PROG <command> [args]

COMMANDS:
  list, ls            List claude sessions whose working dir is under \$PWD
  new   [name]        Start a new claude session in \$PWD and attach to it
  resume [name|#]     Attach to an existing claude session (by name or list #)
  update [name|#]     Restart a session's claude on the latest version, keeping
                      its conversation, model and effort level
  restart [name|#]    Same as update, but skip 'claude update'
  maintain            Look after idle sessions in the background: apply waiting
                      updates and reconnect Remote Control (--install for a
                      systemd timer or cron job that keeps doing it)
  pause               Stop every session under \$PWD cleanly before a reboot,
                      remembering how to bring each one back
  reload              Bring back every session 'pause' recorded, after the reboot
  kill   <name|#>     Kill a claude session (use --all to kill all under \$PWD)
  install [--system]  Install $PROG to ~/.local/bin (or /usr/local/bin)
  help [command]      Show help; pass a command name for details
  version             Print version

EXAMPLES:
  $PROG install                # install for current user
  $PROG new                    # start a claude session in this directory
  $PROG new feature-x          # start a session named claude-feature-x
  $PROG list                   # show claude sessions under this dir tree
  $PROG list --all             # show every claude session on the host
  $PROG list --model           # show the model/effort each session would keep
  $PROG resume                 # pick interactively from the list
  $PROG resume 2               # attach to session #2 from 'list'
  $PROG resume feature-x       # attach by name (prefix optional)
  $PROG update feature-x       # restart claude-feature-x on the new version
  $PROG update --pending       # restart every session waiting for an update
  $PROG maintain --once --dry-run   # what background maintenance would do now
  $PROG maintain --install     # install the maintenance service (timer/cron)
  cd ~ && $PROG pause          # before a reboot: stop every session cleanly
  cd ~ && $PROG reload         # after it: bring them all back
  $PROG kill feature-x         # kill session claude-feature-x
  $PROG kill --all             # kill every claude session under this dir tree
EOF
}

help_for() {
  case "${1:-}" in
    list|ls)
      cat <<EOF
$PROG list [--all] [--model]

List claude sessions managed by $PROG. By default only sessions whose
working directory is at or under \$PWD are shown.

Options:
  --all     Show every claude session on the host, regardless of directory.
  --model   Show the model and effort level a restart would keep, instead of
            the working directory. Read from each session's transcript, so it
            is a best guess when several sessions share a directory.

The STATUS column is read from each session's screen:
  idle | busy | typing            what claude is doing right now
  dialog | no-prompt              waiting for an answer, or not at a prompt
  update-ready                    a newer Claude Code is installed and waiting
                                  for a restart ('$PROG update')
  rc:on | rc:failed | rc:off ...  Remote Control state ('$PROG maintain')
EOF
      ;;
    new|start)
      cat <<EOF
$PROG new [name] [-- <claude args>]

Create a new tmux session in the current directory running 'claude', then
attach to it. The session name is 'claude-<name>' or, if no name is given,
'claude-<basename-of-cwd>'. A numeric suffix (-2, -3, ...) is appended if
that name is already taken.

Anything after '--' is passed to claude, for example:
  $PROG new api -- --model opus
  $PROG new -- --remote-control
EOF
      ;;
    resume|attach|a)
      cat <<EOF
$PROG resume [name|index]

Attach to an existing claude session. The argument may be:
  - the list index shown by '$PROG list'
  - the full tmux session name (e.g. claude-feature-x)
  - the suffix only         (e.g. feature-x)

With no argument the list is printed and you are prompted to pick one.
EOF
      ;;
    update|upgrade)
      cat <<EOF
$PROG update [name|index ...] [--all | --pending] [--force] [--restart-only]
$PROG update ... [-- <claude args>]

Restart the claude inside a session so it runs the newly installed Claude
Code version, without losing the conversation. For each session $PROG:
  1. asks claude to exit (/exit),
  2. reads the "Resume this session with: claude --resume <id>" hint that
     claude prints on the way out,
  3. works out the model and effort level the session was using, from its
     transcript,
  4. starts 'claude --resume <id> --model ... --effort ...' in the same pane.
The tmux session, its name and any attached clients stay as they are, and
Remote Control is turned back on if the session had it.

Claude offers to resume long sessions "from a summary"; $PROG turns that
prompt off, because the point of the restart is to bring the whole
conversation back. The model is restored as a family alias ('opus',
'fable', ...) so an old session cannot come back on a model this version no
longer knows; 'ultracode' effort is restored through --settings.

Before restarting anything, 'claude update' is run once so the latest
version is installed ('$PROG restart' or --restart-only skips that step).

Which sessions:
  (none)       the session you are in when run from a second window of a
               $PROG tmux session; otherwise pick from the list under \$PWD
  name|index   one or more sessions (list #, or name with/without 'claude-')
  --all        every session at or under \$PWD (run it from ~ to get them all)
  --pending    like --all, but only sessions whose footer says
               "Update installed · Restart to apply"

Options:
  -f, --force      also restart sessions that are busy, have unsent text in
                   the prompt, or are showing a dialog (they get interrupted)
  --restart-only   do not run 'claude update' first
  -- <args>        extra arguments for the restarted claude

Sessions that are busy or not sitting at an empty prompt are skipped unless
--force is given. Run this from outside the claude you are restarting (a
second tmux window, or another terminal); it refuses to restart itself.
EOF
      ;;
    restart)
      cat <<EOF
$PROG restart [name|index ...] [--all | --pending] [--force] [-- <claude args>]

Same as '$PROG update --restart-only': stop the claude in a session and
resume the same conversation in the same tmux pane on whatever Claude Code
version is installed, without checking for updates first.
See '$PROG help update' for the details.
EOF
      ;;
    maintain|keepalive|watchdog)
      cat <<EOF
$PROG maintain [options]              run maintenance passes in this terminal
$PROG maintain --once [options]       one pass, then exit
$PROG maintain --install [--cron | --systemd] [options]
$PROG maintain --uninstall | --status | --stop | --daemon

Look after sessions that sit idle for hours, without ever disturbing one
that is in use. Each pass walks every claude-* session on this host and:

  * restarts sessions whose footer says "Update installed · Restart to
    apply", so they come back on the new Claude Code version with their
    conversation, model and effort level intact ('$PROG help update');
  * types /remote-control in sessions showing "/rc failed". Claude Code
    retries a dropped Remote Control connection for about 30 minutes and
    then gives up until somebody runs that command.

A session is only touched when all of this holds: claude is idle at an
empty prompt (not busy, no unsent text, no dialog open), its screen has not
changed for a few seconds, no attached client has typed in it for --idle
minutes, and $PROG has not restarted it within --cooldown minutes. A pass
restarts at most --max sessions and stops restarting after a failure.
Everything skipped is simply looked at again next pass, and only one pass
runs at a time on a host.

Options:
  --once           a single pass, then exit (what the installed job runs)
  --dry-run        report what a pass would do, change nothing
  --interval SECS  seconds between passes (default 900)
  --idle MINS      a session must have been untouched this long (default 15)
  --cooldown MINS  least time between $PROG restarts of a session (default 60)
  --max N          most sessions to restart in one pass (default 2)
  --no-update      leave waiting updates alone (Remote Control only)
  --no-rc          leave Remote Control alone (updates only)
  --ensure         also turn Remote Control on in sessions that have it off
  --restart-rc     restart a session when claude says Remote Control can only
                   be retried after a restart

Running it in the background:
  --install        install the maintenance job: a systemd user timer where
                   there is one, otherwise a cron entry. Add --cron or
                   --systemd to choose, and any options above to bake in.
  --uninstall      remove the timer or cron entry
  --status         show what is installed, when it next runs, recent log
  --stop           stop the --daemon tmux session (not an installed job)
  -d, --daemon     run the loop detached in a tmux session named
                   '$MAINT_SESSION' instead (no files, but it does not
                   survive a reboot)

Unattended passes log to $MAINT_LOG.
'$PROG keepalive' is the old name for this command.
EOF
      ;;
    pause|suspend)
      cat <<EOF
$PROG pause [--all] [--wait MINS] [--force] [--yes] [--dry-run]

Shut every claude session down cleanly before a reboot, remembering enough
to bring each one back afterwards with '$PROG reload'. Run it from a
directory above all your sessions (~, say): by default it takes every
claude-* session whose working directory is at or under \$PWD.

For each session $PROG asks claude to exit (/exit), reads the "Resume this
session with: claude --resume <id>" hint it prints on the way out, works
out the model and effort level from the transcript, and writes the
session's name, directory, resume id, worktree, Remote Control state,
model, effort and any unsent text in its prompt to a manifest under
  $PAUSE_DIR
which survives the reboot. The tmux session itself is left as it is, with
the exit hint on screen: the reboot clears it, and '$PROG reload' reuses it
if there was no reboot after all.

A session that is still working, waiting for an answer on screen, or not
at a prompt yet is waited for, up to --wait minutes, and paused as soon as
it is idle. It is never interrupted: anything still busy when the wait
runs out is left running and listed, and $PROG exits with status 1 so you
know it is not yet safe to reboot. Unsent text in a prompt is saved and
typed back, unsubmitted, when the session is reloaded.

Options:
  --all          every claude session on the host, not only those under \$PWD
  --wait MINS    how long to wait for busy sessions (default 10; 0 = not at all)
  -f, --force    interrupt busy sessions and dismiss dialogs instead of waiting
  -y, --yes      do not ask for confirmation
  -n, --dry-run  show what would be paused and change nothing

Run it from outside the claude you are pausing (a plain terminal, or another
tmux window): the session it is itself running in is left alone. The
'$PROG maintain' service needs no attention: it ignores paused sessions
and picks the reloaded ones up again.
EOF
      ;;
    reload|unpause)
      cat <<EOF
$PROG reload [--dry-run]
$PROG reload --list
$PROG reload --forget NAME [--forget NAME ...]

Bring back every session '$PROG pause' recorded, after the reboot. Each one
is recreated as a tmux session with its original name and working
directory, running 'claude --resume <id>' with the model, effort level and
Remote Control it had, one session at a time. If claude refuses the
restored model or setting it is started once more without them, as
'$PROG restart' does. Unsent prompt text is typed back in, unsubmitted.

A tmux session that still exists with claude exited is reused in place, so
a pause can be undone without a reboot; one already running the same
conversation is left alone. Sessions that come back are removed from the
manifest, those that could not be started stay in it, so running
'$PROG reload' again retries only them. \$PWD does not matter.

Options:
  -n, --dry-run  list what would be started and start nothing
  -l, --list     show what is paused ('$PROG list' mentions it as well)
  --forget NAME  drop a session from the manifest without starting it

The manifest lives under $PAUSE_DIR.
EOF
      ;;
    kill|stop)
      cat <<EOF
$PROG kill <name|index>
$PROG kill --all [--force]

Kill claude sessions.

With a name or list index, kills that one session (name may include or
omit the 'claude-' prefix). With --all, kills every claude session whose
working directory is at or under \$PWD; this prompts for confirmation
unless --force is given.
EOF
      ;;
    install)
      cat <<EOF
$PROG install [--system] [--force]

Copy this script to a directory on PATH.
  (default)   install to ~/.local/bin/$PROG
  --system    install to /usr/local/bin/$PROG  (may require sudo)
  --force     overwrite an existing file without prompting

After installing, make sure the destination directory is on your PATH.
EOF
      ;;
    version|-v|--version)
      printf '%s version\n\nPrint the program version.\n' "$PROG"
      ;;
    ""|help|-h|--help)
      usage
      ;;
    *)
      die "no help for unknown command: $1"
      ;;
  esac
}

# ---------- commands ----------

cmd_list() {
  need tmux
  local scope="here" show_model=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --all)          scope="all" ;;
      --model|--models) show_model=1 ;;
      -h|--help)      help_for list; return 0 ;;
      *)              die "unknown option: $1 (try '$PROG help list')" ;;
    esac
    shift
  done

  local rows; rows=$(_collect_sessions "$scope") || true
  if [ -z "$rows" ]; then
    if [ "$scope" = "here" ]; then
      printf 'no claude sessions under %s\n' "$PWD"
    else
      printf 'no claude sessions on this host\n'
    fi
    _paused_note
    return 0
  fi

  local w
  w=$(awk -F'[|]' '{ if (length($1) > m) m = length($1) } END { print (m > 4 ? m : 4) }' <<< "$rows")
  if [ "$show_model" -eq 1 ]; then
    printf "%-3s  %-${w}s  %-8s  %-28s  %s\n" '#' 'NAME' 'AGE' 'STATUS' 'MODEL/EFFORT'
  else
    printf "%-3s  %-${w}s  %-8s  %-8s  %-28s  %s\n" '#' 'NAME' 'ATTACHED' 'AGE' 'STATUS' 'PATH'
  fi
  local i=0 name path attached created att tags
  while IFS='|' read -r name attached created path; do
    i=$((i+1))
    att="no"; [ "${attached:-0}" -gt 0 ] && att="yes"
    tags=$(_pane_tags "$(_claude_pane "$name")")
    if [ "$tags" = "exited" ] && [ -f "$(_pause_file "$name")" ]; then tags="paused"; fi
    if [ "$show_model" -eq 1 ]; then
      printf "%-3s  %-${w}s  %-8s  %-28s  %s\n" \
        "$i" "$name" "$(_human_age "$created")" "$tags" "$(_restore_summary "$name" "$(_session_id "$name" "$path")")"
    else
      printf "%-3s  %-${w}s  %-8s  %-8s  %-28s  %s\n" \
        "$i" "$name" "$att" "$(_human_age "$created")" "$tags" "$path"
    fi
  done <<< "$rows"
  _paused_note
}

cmd_new() {
  need tmux
  need claude
  local name_arg="" extra=()
  while [ $# -gt 0 ]; do
    case "$1" in
      -h|--help) help_for new; return 0 ;;
      --)        shift; extra=("$@"); break ;;
      -*)        die "unknown option: $1 (try '$PROG help new')" ;;
      *)         [ -z "$name_arg" ] || die "unexpected argument: $1 (try '$PROG help new')"
                 name_arg="$1" ;;
    esac
    shift
  done

  local base="${name_arg:-$(basename "$PWD")}"
  # tmux session names cannot contain '.' or ':'
  base="${base//[.:]/_}"
  local name="${SESSION_PREFIX}${base}"
  if tmux has-session -t "=$name" 2>/dev/null; then
    local n=2
    while tmux has-session -t "=${name}-${n}" 2>/dev/null; do n=$((n+1)); done
    name="${name}-${n}"
  fi

  tmux new-session -d -s "$name" -c "$PWD" "$(_shell_join claude ${extra[@]+"${extra[@]}"})"
  _remember_flags "$name" ${extra[@]+"${extra[@]}"}
  printf 'started %s in %s\n' "$name" "$PWD"
  _attach "$name"
}

cmd_resume() {
  need tmux
  while [ $# -gt 0 ]; do
    case "$1" in
      -h|--help) help_for resume; return 0 ;;
      --)        shift; break ;;
      -*)        die "unknown option: $1 (try '$PROG help resume')" ;;
      *)         break ;;
    esac
    shift
  done

  local target
  if [ -n "${1:-}" ]; then
    target=$(_resolve_session "$1")
  else
    target=$(_pick_session)
  fi
  _attach "$target"
}

cmd_update() {
  need tmux
  need claude
  local all=0 pending=0 force=0 do_update=1 n target pane
  local -a names=() extra=() targets=() kept=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --all)                    all=1 ;;
      --pending)                pending=1; all=1 ;;
      -f|--force)               force=1 ;;
      --restart-only|--no-update) do_update=0 ;;
      -h|--help)                help_for update; return 0 ;;
      --)                       shift; extra=("$@"); break ;;
      -*)                       die "unknown option: $1 (try '$PROG help update')" ;;
      *)                        names+=("$1") ;;
    esac
    shift
  done

  if [ "$all" -eq 1 ]; then
    [ ${#names[@]} -eq 0 ] || die "cannot combine --all/--pending with a name or index"
    local rows name _rest
    rows=$(_collect_sessions "here") || true
    if [ -z "$rows" ]; then printf 'no claude sessions under %s\n' "$PWD"; return 0; fi
    while IFS='|' read -r name _rest; do targets+=("$name"); done <<< "$rows"
  elif [ ${#names[@]} -gt 0 ]; then
    for n in "${names[@]}"; do
      target=$(_resolve_session "$n")
      targets+=("$target")
    done
  else
    target=$(_current_session)
    if [ -z "$target" ]; then target=$(_pick_session); fi
    targets=("$target")
  fi

  if [ "$pending" -eq 1 ]; then
    for n in "${targets[@]}"; do
      pane=$(_claude_pane "$n")
      if [ -n "$pane" ] && _pane_update_ready "$pane"; then kept+=("$n"); fi
    done
    if [ ${#kept[@]} -eq 0 ]; then printf 'no sessions under %s are waiting for a restart\n' "$PWD"; return 0; fi
    targets=("${kept[@]}")
  fi

  if [ "$do_update" -eq 1 ]; then
    printf 'checking for claude updates...\n'
    claude update || die "'claude update' failed; no sessions were restarted (use --restart-only to restart anyway)"
  fi

  # Wait a little for a maintenance pass to finish, then go ahead regardless:
  # the person at the keyboard should not be blocked by the background service.
  if [ -d "$STATE_DIR/lock" ]; then
    printf 'waiting for a running %s maintain pass...\n' "$PROG"
  fi
  if ! _lock_acquire 60; then
    warn "a '$PROG maintain' pass is still running; continuing anyway"
  fi

  local ok=0 skipped=0
  for n in "${targets[@]}"; do
    if _restart_session "$n" "$force" ${extra[@]+"${extra[@]}"}; then
      ok=$((ok+1))
    else
      skipped=$((skipped+1))
    fi
  done
  if [ ${#targets[@]} -gt 1 ]; then
    printf '%d restarted, %d skipped\n' "$ok" "$skipped"
  fi
  [ "$skipped" -eq 0 ]
}

cmd_restart() {
  cmd_update --restart-only "$@"
}

# ---------- maintenance ----------
# A maintenance pass looks at every claude-* session on the host and fixes the
# two things that rot while a session sits idle: a Claude Code update that is
# installed but waiting for a restart, and a Remote Control connection that has
# given up. It is deliberately timid. A session is only touched when claude is
# idle at an empty prompt, its screen has not changed for a few seconds, nobody
# has typed in it for a while, and cmm has not restarted it recently; anything
# else is left exactly as it is and looked at again next time.

MT_DRY=0; MT_UPDATE=1; MT_RC=1; MT_ENSURE=0; MT_RESTART_RC=0
MT_IDLE=15; MT_COOLDOWN=60; MT_MAX=2

# True if it is safe to touch session $1 right now ($3 is why we want to).
_maint_ready() {
  local name="$1" pane="$2" why="$3" state
  state=$(_pane_input_state "$pane")
  if [ "$state" != "empty" ]; then
    log "$name: $why, but claude is $state; leaving it alone"
    return 1
  fi
  if _session_recently_active "$name" $(( MT_IDLE * 60 )); then
    log "$name: $why, but it was used in the last ${MT_IDLE}m; leaving it alone"
    return 1
  fi
  if ! _pane_stable "$pane" 3; then
    log "$name: $why, but its screen is still changing; leaving it alone"
    return 1
  fi
  if [ "$(_pane_input_state "$pane")" != "empty" ]; then
    log "$name: $why, but it just became busy; leaving it alone"
    return 1
  fi
  return 0
}

# True if cmm has not restarted session $1 within the cooldown.
_maint_cooldown_ok() {
  local last
  last=$(_sess_get "$1" @cmm_last_restart)
  [ -n "$last" ] || return 0
  case "$last" in ''|*[!0-9]*) return 0 ;; esac
  [ $(( $(date +%s) - last )) -ge $(( MT_COOLDOWN * 60 )) ]
}

# Restart a session as part of a pass, logging the outcome on one line.
_maint_restart() {
  local out rc=0
  out=$(_restart_session "$1" 0 2>&1) || rc=1
  log "$(printf '%s' "$out" | tr '\n' ' ')"
  return "$rc"
}

_maintain_pass() {
  local rows name _rest pane rc restarts=0 acted=0 broke=0 seen=0

  rows=$(_collect_sessions "all") || true
  if [ -z "$rows" ]; then log "no claude sessions on this host"; return 0; fi

  if [ "$MT_UPDATE" -eq 1 ] && [ "$MT_DRY" -eq 0 ]; then
    claude update >/dev/null 2>&1 || log "'claude update' failed; carrying on with the installed version"
  fi

  while IFS='|' read -r name _rest; do
    [ -n "$name" ] || continue
    pane=$(_claude_pane "$name")
    [ -n "$pane" ] || continue
    if _pane_dead "$pane"; then continue; fi
    if [ "${TMUX_PANE:-}" = "$pane" ]; then continue; fi   # never ourselves
    seen=$(( seen + 1 ))
    rc=$(_pane_rc_state "$pane")

    # A restart applies a waiting update and brings Remote Control back with it.
    if [ "$MT_UPDATE" -eq 1 ] && _pane_update_ready "$pane"; then
      if [ "$broke" -eq 1 ]; then
        log "$name: update waiting, but a restart already failed this pass; leaving it alone"
      elif [ "$restarts" -ge "$MT_MAX" ]; then
        log "$name: update waiting, but $MT_MAX session(s) were restarted this pass; next time"
      elif ! _maint_cooldown_ok "$name"; then
        log "$name: update waiting, but cmm restarted it less than ${MT_COOLDOWN}m ago; next time"
      elif _maint_ready "$name" "$pane" "update waiting"; then
        if [ "$MT_DRY" -eq 1 ]; then
          log "$name: update waiting; would restart it (dry run)"
        else
          log "$name: update waiting; restarting"
          if _maint_restart "$name"; then
            restarts=$(( restarts + 1 )); acted=$(( acted + 1 ))
          else
            broke=1
            log "no more restarts this pass"
          fi
        fi
        continue
      fi
    fi

    # Remote Control that has stopped retrying.
    if [ "$MT_RC" -eq 1 ]; then
      case "$rc" in
        failed) ;;
        off)    [ "$MT_ENSURE" -eq 1 ] || continue ;;
        *)      continue ;;
      esac
      _maint_ready "$name" "$pane" "remote control $rc" || continue
      if [ "$MT_DRY" -eq 1 ]; then
        log "$name: remote control $rc; would type /remote-control (dry run)"
        continue
      fi
      log "$name: remote control $rc; typing /remote-control"
      if ! _type_command "$pane" '/remote-control'; then
        log "$name: could not get /remote-control into the prompt; will retry later"
        continue
      fi
      acted=$(( acted + 1 ))
      sleep 3
      if [ "$(_pane_prompt_typed "$pane")" = "/remote-control" ]; then
        tmux send-keys -t "$pane" Enter
        sleep 2
      fi
      # A slash command should leave the session back at an empty prompt. If it
      # opened something instead (claude answers with its Remote Control menu
      # when the session turns out to be connected after all), close that again
      # rather than leaving the session sitting on a dialog.
      if [ "$(_pane_input_state "$pane")" != "empty" ]; then
        tmux send-keys -t "$pane" Escape
        sleep 1
      fi
      log "$name: remote control is now $(_pane_rc_state "$pane")"
      if [ "$MT_RESTART_RC" -eq 1 ] && [ "$broke" -eq 0 ] && [ "$restarts" -lt "$MT_MAX" ]; then
        sleep 20
        if [ "$(_pane_rc_state "$pane")" = "failed" ] && _pane_rc_needs_restart "$pane" \
           && _maint_cooldown_ok "$name"; then
          log "$name: claude wants a restart before it will retry; restarting"
          if _maint_restart "$name"; then restarts=$(( restarts + 1 )); else broke=1; fi
        fi
      fi
    fi
  done <<< "$rows"

  log "pass finished: $seen session(s) checked, $acted acted on"
}

# Keep the log from growing without bound.
_log_rotate() {
  local size
  [ -f "$MAINT_LOG" ] || return 0
  size=$(wc -c < "$MAINT_LOG" 2>/dev/null) || size=0
  [ "${size:-0}" -gt "$LOG_MAX_BYTES" ] || return 0
  if tail -n 500 "$MAINT_LOG" > "$MAINT_LOG.new" 2>/dev/null; then
    mv "$MAINT_LOG.new" "$MAINT_LOG" 2>/dev/null || rm -f "$MAINT_LOG.new" 2>/dev/null || true
  fi
}

# The options an installed service should run each pass with.
_maint_service_opts() {
  local -a opts=(maintain --once --interval "$1")
  [ "$MT_UPDATE" -eq 1 ]      || opts+=(--no-update)
  [ "$MT_RC" -eq 1 ]          || opts+=(--no-rc)
  [ "$MT_ENSURE" -eq 0 ]      || opts+=(--ensure)
  [ "$MT_RESTART_RC" -eq 0 ]  || opts+=(--restart-rc)
  [ "$MT_DRY" -eq 0 ]         || opts+=(--dry-run)
  opts+=(--idle "$MT_IDLE" --cooldown "$MT_COOLDOWN" --max "$MT_MAX")
  printf '%s\n' "${opts[@]}"
}

# A PATH a service can rely on: cron and systemd start with almost nothing, and
# claude often lives somewhere like ~/.nvm/versions/node/<version>/bin.
_service_path_env() {
  local p="" d
  for d in "$(dirname "$(command -v claude)")" "$(dirname "$(command -v tmux)")" \
           "$HOME/.local/bin" /usr/local/bin /usr/bin /bin; do
    [ -n "$d" ] || continue
    case ":$p:" in *":$d:"*) continue ;; esac
    p="${p:+$p:}$d"
  done
  printf '%s' "$p"
}

_systemd_available() {
  command -v systemctl >/dev/null 2>&1 && systemctl --user show-environment >/dev/null 2>&1
}

_service_install() {
  local how="$1" interval="$2" self unit dir sched mins line path_env
  local -a opts=()
  while IFS= read -r line; do opts+=("$line"); done < <(_maint_service_opts "$interval")
  self=$(_self_path)
  path_env=$(_service_path_env)
  mkdir -p "$STATE_DIR" 2>/dev/null || true

  if [ -z "$how" ]; then
    if _systemd_available; then how="systemd"; else how="cron"; fi
  fi

  if [ "$how" = "systemd" ]; then
    _systemd_available || die "no systemd user session here; try '$PROG maintain --install --cron'"
    _service_remove_cron quiet || true      # one scheduler at a time
    dir="$HOME/.config/systemd/user"
    mkdir -p "$dir" || die "cannot create $dir"
    unit="$dir/$MAINT_SESSION.service"
    cat > "$unit" <<EOF
[Unit]
Description=cmm: keep idle claude sessions updated and Remote Control connected

[Service]
Type=oneshot
Environment=PATH=$path_env
ExecStart=$(_shell_join "$self" "${opts[@]}")
EOF
    cat > "$dir/$MAINT_SESSION.timer" <<EOF
[Unit]
Description=Run cmm maintenance every ${interval}s

[Timer]
OnBootSec=5min
OnUnitActiveSec=${interval}s
AccuracySec=1min

[Install]
WantedBy=timers.target
EOF
    systemctl --user daemon-reload || die "systemctl --user daemon-reload failed"
    systemctl --user enable --now "$MAINT_SESSION.timer" \
      || die "could not enable $MAINT_SESSION.timer"
    printf 'installed systemd user timer %s.timer (every %ss)\n' "$MAINT_SESSION" "$interval"
    printf '  runs: %s\n' "$(_shell_join "$self" "${opts[@]}")"
    printf '  log:  %s\n' "$MAINT_LOG"
    case "$(loginctl show-user "$USER" -p Linger 2>/dev/null)" in
      *=yes) ;;
      *) printf 'note: run "loginctl enable-linger %s" so it also runs while you are logged out\n' "$USER" ;;
    esac
    return 0
  fi

  command -v crontab >/dev/null 2>&1 || die "crontab not found; try '$PROG maintain --install --systemd'"
  _service_remove_systemd quiet || true     # one scheduler at a time
  mins=$(( interval / 60 )); [ "$mins" -ge 1 ] || mins=1
  if [ "$mins" -lt 60 ]; then
    sched="*/$mins * * * *"
  else
    sched="0 */$(( mins / 60 > 23 ? 23 : mins / 60 )) * * *"
  fi
  {
    _crontab_without_block
    printf '# BEGIN %s (managed by %s; edit with "%s maintain --install")\n' "$MAINT_SESSION" "$PROG" "$PROG"
    printf '%s PATH=%s:$PATH %s >/dev/null 2>>%s\n' \
      "$sched" "$path_env" "$(_shell_join "$self" "${opts[@]}")" "$MAINT_LOG"
    printf '# END %s\n' "$MAINT_SESSION"
  } | crontab - || die "could not write the crontab"
  printf 'installed cron job (%s)\n' "$sched"
  printf '  runs: %s\n' "$(_shell_join "$self" "${opts[@]}")"
  printf '  log:  %s\n' "$MAINT_LOG"
}

# The user's crontab with cmm's block taken out (the markers start the lines;
# the BEGIN line carries a comment after the marker).
_crontab_without_block() {
  crontab -l 2>/dev/null | awk -v b="# BEGIN $MAINT_SESSION" -v e="# END $MAINT_SESSION" '
    index($0, b) == 1 { skip = 1; next }
    index($0, e) == 1 { skip = 0; next }
    skip == 0 { print }'
}

# Each of these removes one mechanism and says whether there was one to remove.
_service_remove_systemd() {
  local dir="$HOME/.config/systemd/user"
  [ -f "$dir/$MAINT_SESSION.timer" ] || return 1
  if _systemd_available; then
    systemctl --user disable --now "$MAINT_SESSION.timer" >/dev/null 2>&1 || true
  fi
  rm -f "$dir/$MAINT_SESSION.timer" "$dir/$MAINT_SESSION.service"
  if _systemd_available; then systemctl --user daemon-reload >/dev/null 2>&1 || true; fi
  [ "${1:-}" = "quiet" ] || printf 'removed systemd user timer %s.timer\n' "$MAINT_SESSION"
  return 0
}

_service_remove_cron() {
  command -v crontab >/dev/null 2>&1 || return 1
  crontab -l 2>/dev/null | grep -q "BEGIN $MAINT_SESSION" || return 1
  _crontab_without_block | crontab -
  [ "${1:-}" = "quiet" ] || printf 'removed the cron job\n'
  return 0
}

_service_uninstall() {
  local removed=0
  if _service_remove_systemd; then removed=1; fi
  if _service_remove_cron; then removed=1; fi
  [ "$removed" -eq 1 ] || printf 'no %s service was installed\n' "$PROG"
}

_maint_status() {
  local dir="$HOME/.config/systemd/user" pane found=0
  printf '%s maintain\n' "$PROG"
  if [ -f "$dir/$MAINT_SESSION.timer" ]; then
    found=1
    printf '  systemd:  %s.timer (%s)\n' "$MAINT_SESSION" \
      "$(systemctl --user is-active "$MAINT_SESSION.timer" 2>/dev/null || printf 'inactive')"
    systemctl --user list-timers "$MAINT_SESSION.timer" --no-pager 2>/dev/null \
      | sed -n '1,2p' | sed -e 's/^/            /'
  fi
  if command -v crontab >/dev/null 2>&1; then
    if crontab -l 2>/dev/null | grep -q "BEGIN $MAINT_SESSION"; then
      found=1
      printf '  cron:     %s\n' "$(crontab -l 2>/dev/null | grep -A1 "BEGIN $MAINT_SESSION" \
        | tail -n 1 | awk '{ print $1, $2, $3, $4, $5 }')"
    fi
  fi
  if tmux has-session -t "=$MAINT_SESSION" 2>/dev/null; then
    found=1
    pane=$(tmux list-panes -t "=$MAINT_SESSION" -F '#{pane_id}' 2>/dev/null | head -n 1)
    if _pane_dead "$pane"; then
      printf '  daemon:   tmux session %s has stopped\n' "$MAINT_SESSION"
    else
      printf '  daemon:   running in tmux session %s\n' "$MAINT_SESSION"
    fi
  fi
  if tmux has-session -t "=$LEGACY_SESSION" 2>/dev/null; then
    found=1
    printf '  old:      a pre-0.4.0 keepalive daemon is still running in tmux session %s\n' "$LEGACY_SESSION"
    printf '            stop it with "%s maintain --stop"\n' "$PROG"
  fi
  [ "$found" -eq 1 ] || printf '  not installed (%s maintain --install)\n' "$PROG"
  if [ -f "$MAINT_LOG" ]; then
    printf '  log:      %s\n\n' "$MAINT_LOG"
    tail -n 15 "$MAINT_LOG" | sed -e 's/^/  /'
  elif tmux has-session -t "=$MAINT_SESSION" 2>/dev/null; then
    printf '\n'
    tmux capture-pane -p -J -t "$pane" -S -200 2>/dev/null | sed -e '/^[[:space:]]*$/d' | tail -n 15
  fi
}

cmd_maintain() {
  need tmux
  local interval=900 once=0 daemon=0 stop=0 status=0 install=0 uninstall=0 how=""
  local pane self _v
  while [ $# -gt 0 ]; do
    case "$1" in
      --interval)   [ $# -ge 2 ] || die "--interval needs a value"; interval="$2"; shift ;;
      --interval=*) interval="${1#*=}" ;;
      --idle)       [ $# -ge 2 ] || die "--idle needs a value"; MT_IDLE="$2"; shift ;;
      --idle=*)     MT_IDLE="${1#*=}" ;;
      --cooldown)   [ $# -ge 2 ] || die "--cooldown needs a value"; MT_COOLDOWN="$2"; shift ;;
      --cooldown=*) MT_COOLDOWN="${1#*=}" ;;
      --max)        [ $# -ge 2 ] || die "--max needs a value"; MT_MAX="$2"; shift ;;
      --max=*)      MT_MAX="${1#*=}" ;;
      --once)       once=1 ;;
      --dry-run)    MT_DRY=1 ;;
      --no-update)  MT_UPDATE=0 ;;
      --no-rc)      MT_RC=0 ;;
      --ensure)     MT_ENSURE=1 ;;
      --restart-rc|--restart) MT_RESTART_RC=1 ;;
      -d|--daemon)  daemon=1 ;;
      --install)    install=1 ;;
      --uninstall)  uninstall=1 ;;
      --cron)       how="cron" ;;
      --systemd)    how="systemd" ;;
      --stop)       stop=1 ;;
      --status)     status=1 ;;
      -h|--help)    help_for maintain; return 0 ;;
      *)            die "unknown option: $1 (try '$PROG help maintain')" ;;
    esac
    shift
  done
  [[ "$interval" =~ ^[0-9]+$ ]] && [ "$interval" -ge 60 ] \
    || die "--interval must be a number of seconds (60 or more)"
  for _v in "$MT_IDLE" "$MT_COOLDOWN" "$MT_MAX"; do
    [[ "$_v" =~ ^[0-9]+$ ]] || die "--idle, --cooldown and --max take whole numbers"
  done

  if [ "$status" -eq 1 ];    then _maint_status; return 0; fi
  if [ "$uninstall" -eq 1 ]; then _service_uninstall; return 0; fi
  if [ "$install" -eq 1 ];   then need claude; _service_install "$how" "$interval"; return 0; fi

  if [ "$stop" -eq 1 ]; then
    if tmux kill-session -t "=$MAINT_SESSION" 2>/dev/null; then
      printf 'stopped the %s daemon\n' "$PROG"
    else
      printf 'no %s daemon is running\n' "$PROG"
    fi
    if tmux kill-session -t "=$LEGACY_SESSION" 2>/dev/null; then
      printf 'stopped the old keepalive daemon (%s)\n' "$LEGACY_SESSION"
    fi
    if [ -f "$HOME/.config/systemd/user/$MAINT_SESSION.timer" ] \
       || { command -v crontab >/dev/null 2>&1 && crontab -l 2>/dev/null | grep -q "BEGIN $MAINT_SESSION"; }; then
      printf 'note: an installed service is still scheduled (%s maintain --uninstall)\n' "$PROG"
    fi
    return 0
  fi

  if [ "$daemon" -eq 1 ]; then
    if tmux has-session -t "=$MAINT_SESSION" 2>/dev/null; then
      pane=$(tmux list-panes -t "=$MAINT_SESSION" -F '#{pane_id}' 2>/dev/null | head -n 1)
      if _pane_dead "$pane"; then
        tmux kill-session -t "=$MAINT_SESSION" 2>/dev/null || true
      else
        printf 'already running (see: %s maintain --status)\n' "$PROG"
        return 0
      fi
    fi
    local -a opts=()
    local line
    while IFS= read -r line; do
      [ "$line" = "--once" ] || opts+=("$line")   # the daemon loops instead
    done < <(_maint_service_opts "$interval")
    self=$(_self_path)
    mkdir -p "$STATE_DIR" 2>/dev/null || true
    # log to the file as well as to the pane, so --status shows the same thing
    tmux new-session -d -s "$MAINT_SESSION" -c "$HOME" \
      "$(_shell_join env "CMM_LOG=$MAINT_LOG" "$self" "${opts[@]}")"
    pane=$(tmux list-panes -t "=$MAINT_SESSION" -F '#{pane_id}' 2>/dev/null | head -n 1)
    if [ -n "$pane" ]; then _set_remain "$pane" on; fi
    printf 'started the %s daemon in tmux session %s (every %ss)\n' "$PROG" "$MAINT_SESSION" "$interval"
    return 0
  fi

  # A run that nobody is watching keeps a log of its own.
  if [ ! -t 1 ] && [ -z "${CMM_LOG:-}" ]; then
    mkdir -p "$STATE_DIR" 2>/dev/null || true
    _log_rotate
    CMM_LOG="$MAINT_LOG"
  fi

  log "maintenance started: every ${interval}s, idle ${MT_IDLE}m, cooldown ${MT_COOLDOWN}m, max ${MT_MAX}/pass$( [ "$MT_DRY" -eq 1 ] && printf ', dry run' )$( [ "$MT_UPDATE" -eq 0 ] && printf ', no updates' )$( [ "$MT_RC" -eq 0 ] && printf ', no remote control' )"
  while :; do
    if _lock_acquire 0; then
      _maintain_pass || log "pass failed (exit $?)"
      _lock_release
    else
      log "another $PROG run is working on these sessions; skipping this pass"
    fi
    [ "$once" -eq 0 ] || break
    sleep "$interval"
  done
}

# ---------- pause / reload ----------
# A reboot takes every tmux session with it. `pause` shuts each claude down
# cleanly first and writes what `reload` needs to bring the session back: one
# small key=value file per session under PAUSE_DIR, which outlives the tmux
# server. `reload` recreates the sessions from those files and removes each
# file once its session is back, so a rerun only retries what failed.

# The manifest file for session $1 (tmux names cannot contain '.' or ':',
# but be safe about the one character that matters to a path).
_pause_file() { printf '%s/%s\n' "$PAUSE_DIR" "${1//\//_}"; }

# The manifest files, one per line.
_pause_files() { ls "$PAUSE_DIR/$SESSION_PREFIX"* 2>/dev/null || true; }

# Read manifest file $1 into P_name, P_path, P_session, P_worktree, P_rc,
# P_model, P_effort, P_typed and P_paused. Unsent text is kept on one line
# with backslashes and newlines escaped, so a manifest stays a file of
# plain lines.
_pause_read() {
  local key val
  P_name=""; P_path=""; P_session=""; P_worktree=""; P_rc="off"
  P_model=""; P_effort=""; P_typed=""; P_paused=""
  while IFS='=' read -r key val; do
    case "$key" in
      name)     P_name="$val" ;;
      path)     P_path="$val" ;;
      session)  P_session="$val" ;;
      worktree) P_worktree="$val" ;;
      rc)       P_rc="$val" ;;
      model)    P_model="$val" ;;
      effort)   P_effort="$val" ;;
      typed)    P_typed=$(printf '%b' "$val") ;;
      paused)   P_paused="$val" ;;
    esac
  done < "$1"
  [ -n "$P_name" ]
}

# Write the manifest for session $1 from the same P_* variables.
_pause_write() {
  local file val
  file=$(_pause_file "$1")
  mkdir -p "$PAUSE_DIR" 2>/dev/null || die "cannot create $PAUSE_DIR"
  val="${P_typed//\\/\\\\}"; val="${val//$'\n'/\\n}"
  {
    printf 'name=%s\n'     "$1"
    printf 'path=%s\n'     "$P_path"
    printf 'session=%s\n'  "$P_session"
    printf 'worktree=%s\n' "$P_worktree"
    printf 'rc=%s\n'       "$P_rc"
    printf 'model=%s\n'    "$P_model"
    printf 'effort=%s\n'   "$P_effort"
    printf 'typed=%s\n'    "$val"
    printf 'paused=%s\n'   "$(date +%s)"
  } > "$file.tmp" && mv -f "$file.tmp" "$file"
}

# Continuation lines of the input box: what follows the '❯' line up to the
# box's bottom border, with the indent removed. Empty unless a multi-line
# prompt is being composed.
_pane_prompt_more() {
  _pane_text "$1" | awk '
    { l[NR] = $0 }
    END {
      for (i = NR; i > 0 && i > NR - 12; i--)
        if (l[i] ~ /^❯/ && i > 1 && l[i-1] ~ /^[[:space:]]*─/) { start = i; break }
      if (!start) exit
      for (i = start + 1; i <= NR; i++) {
        if (l[i] ~ /^[[:space:]]*─/) break
        s = l[i]; sub(/^  /, "", s); sub(/[ \t]+$/, "", s); print s
      }
    }'
}

# The unsent text in a pane's prompt, newlines included.
_pane_unsent() {
  local first more
  first=$(_pane_prompt_typed "$1")
  more=$(_pane_prompt_more "$1")
  printf '%s' "$first"
  [ -z "$more" ] || printf '\n%s' "$more"
}

# Put text into a prompt without submitting it. One line is typed a character
# at a time and checked (a long line wraps inside the box, so the first line
# of the box is then a prefix of it); more than one line goes in as a
# bracketed paste, which claude keeps as unsent input. Returns 1 if the
# prompt does not show the text afterwards.
_type_text() {
  local pane="$1" text="$2" attempt i c shown
  case "$text" in
    *$'\n'*)
      printf '%s' "$text" | tmux load-buffer -b cmm-unsent - 2>/dev/null || return 1
      tmux paste-buffer -p -r -d -b cmm-unsent -t "$pane"
      sleep 1
      [ "$(_pane_input_state "$pane")" = "typing" ]
      return
      ;;
  esac
  for attempt in 1 2; do
    for (( i = 0; i < ${#text}; i++ )); do
      c="${text:i:1}"
      [ "$c" != ';' ] || c='\;'      # a lone ';' would end the tmux command
      tmux send-keys -l -t "$pane" "$c"
      sleep 0.03
    done
    sleep 0.5
    shown=$(_pane_prompt_typed "$pane")
    if [ "$shown" = "$text" ] \
       || { [ ${#shown} -ge 40 ] && [ "${text#"$shown"}" != "$text" ]; }; then
      return 0
    fi
    tmux send-keys -t "$pane" C-c   # clear whatever ended up there and try once more
    sleep 0.7
  done
  return 1
}

# Pause one session: stop its claude cleanly and write the manifest entry.
# $2 = 1 to interrupt a busy claude or dismiss a dialog. Returns 1 if the
# session was left running, 2 if it is not ready (busy, showing a dialog, not
# at a prompt) and should be looked at again; the caller decides how long.
_pause_session() {
  local name="$1" force="$2" pane state="" text file how
  pane=$(_claude_pane "$name")
  [ -n "$pane" ] || { warn "$name: no pane found; left alone"; return 1; }
  if [ "${TMUX_PANE:-}" = "$pane" ]; then
    warn "$name: this command is running inside that session's claude; pause it from another terminal"
    return 1
  fi
  file=$(_pause_file "$name")
  P_name="$name"; P_typed=""; P_session=""; P_worktree=""; P_model=""; P_effort=""
  P_path=$(_pane_fmt "$pane" '#{pane_current_path}')
  P_rc=$(_pane_rc_state "$pane")

  if _pane_dead "$pane"; then
    if [ -f "$file" ]; then printf '%s: already paused\n' "$name"; return 0; fi
    printf '%s: claude already exited; ' "$name"
  else
    state=$(_pane_input_state "$pane")
    case "$state" in
      empty|typing) ;;
      *) [ "$force" -eq 1 ] || return 2 ;;
    esac
    if [ "$state" = "typing" ]; then P_typed=$(_pane_unsent "$pane"); fi
    _set_remain "$pane" on
    printf '%s: stopping claude... ' "$name"
    if ! _exit_claude "$pane" 30; then
      printf 'no\n'
      _set_remain "$pane" unset
      warn "$name: claude did not exit within 30s; left running"
      return 1
    fi
  fi

  text=$(tmux capture-pane -p -J -t "$pane" -S -300 2>/dev/null || true)
  P_session=$(_parse_resume_arg "$text")
  P_worktree=$(_parse_worktree "$text")
  how=""
  if [ -z "$P_session" ]; then
    # No hint on screen. After a clean exit the transcript claude just wrote
    # is the newest one for the directory; for a pane that died some time
    # ago only cmm's own note about the session can be trusted.
    if [ -n "$state" ]; then
      P_session=$(_session_id "$name" "$P_path" 120)
    else
      P_session=$(_session_id "$name" "$P_path" 0)
    fi
    if [ -n "$P_session" ]; then
      how="no resume hint on screen; using the newest transcript, "
    else
      how="no conversation to resume; will start a new one, "
    fi
  fi
  { read -r P_model; read -r P_effort; } < <(_restore_pick "$name" "$P_session")
  _pause_write "$name"
  printf 'paused (%s%s%s)\n' "$how" "$(_kept_summary "$P_model" "$P_effort")" \
    "$( [ -z "$P_typed" ] || printf ', unsent text saved' )"
}

# Bring one paused session back from manifest file $1. Returns 1 if it could
# not be started; the file is kept then, for another try.
_reload_session() {
  local file="$1" name pane cur
  _pause_read "$file" || { warn "unreadable manifest $file; skipped"; return 1; }
  name="$P_name"
  if [ ! -d "$P_path" ]; then
    warn "$name: its directory $P_path does not exist; left in the manifest"
    return 1
  fi
  if tmux has-session -t "=$name" 2>/dev/null; then
    pane=$(_claude_pane "$name")
    if ! _pane_dead "$pane"; then
      cur=$(_pane_fmt "$pane" '#{pane_current_command}')
      case "$cur" in
        claude|claude.exe|node)
          if [ -n "$P_session" ] && [ "$(_sess_get "$name" @cmm_session)" = "$P_session" ]; then
            printf '%s: already running that conversation\n' "$name"
            rm -f "$file"
            return 0
          fi
          warn "$name: a claude is already running there, maybe on another conversation; left in the manifest ('$PROG reload --forget $name' drops it)"
          return 1 ;;
        *)
          warn "$name: its tmux session exists and is running '$cur'; left in the manifest"
          return 1 ;;
      esac
    fi
    printf '%s: tmux session still there; ' "$name"
  else
    tmux new-session -d -s "$name" -c "$P_path" \
      || { warn "$name: could not create the tmux session"; return 1; }
    pane=$(tmux list-panes -t "=$name" -F '#{pane_id}' 2>/dev/null | head -n 1)
    printf '%s: ' "$name"
  fi
  printf 'starting claude... '
  _bring_up "$name" "$pane" "$P_path" "$P_session" "$P_worktree" "$P_rc" "$P_model" "$P_effort" || return 1
  rm -f "$file"
  if [ -n "$P_typed" ]; then
    if _type_text "$pane" "$P_typed"; then
      CAME_BACK="${CAME_BACK%)}, unsent text put back)"
    else
      warn "$name: could not put the unsent text back into the prompt; it was:"
      printf '%s\n' "$P_typed" >&2
    fi
  fi
  printf 'reloaded %s\n' "$CAME_BACK"
}

# What is paused right now, as a table.
_pause_list() {
  local f w
  w=$(_pause_files | awk -F/ '{ if (length($NF) > m) m = length($NF) } END { print (m > 4 ? m : 4) }')
  printf "%-${w}s  %-8s  %-36s  %-18s  %s\n" 'NAME' 'PAUSED' 'CONVERSATION' 'MODEL/EFFORT' 'PATH'
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    _pause_read "$f" || continue
    printf "%-${w}s  %-8s  %-36s  %-18s  %s%s\n" "$P_name" "$(_human_age "${P_paused:-0}")" \
      "${P_session:-(new)}" "$(_kept_summary "$P_model" "$P_effort")" "$P_path" \
      "$( [ -z "$P_typed" ] || printf '  (unsent text saved)' )"
  done < <(_pause_files)
}

# A line for 'list' when something is waiting for a reload.
_paused_note() {
  local n
  n=$(_pause_files | wc -l)
  [ "${n:-0}" -gt 0 ] || return 0
  printf '%d paused session(s) waiting for "%s reload" ("%s reload --list" shows them)\n' "$n" "$PROG" "$PROG"
}

cmd_pause() {
  need tmux
  local scope="here" force=0 yes=0 dry=0 wait_mins=10 where
  local rows name _rest pane state n now deadline first=1 elsewhere=0 paused=0 rc ans w
  local -a targets=() todo=() later=() left=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --all)        scope="all" ;;
      --wait)       [ $# -ge 2 ] || die "--wait needs a number of minutes"; wait_mins="$2"; shift ;;
      --wait=*)     wait_mins="${1#*=}" ;;
      -f|--force)   force=1 ;;
      -y|--yes)     yes=1 ;;
      -n|--dry-run) dry=1 ;;
      -h|--help)    help_for pause; return 0 ;;
      *)            die "unknown option: $1 (try '$PROG help pause')" ;;
    esac
    shift
  done
  [[ "$wait_mins" =~ ^[0-9]+$ ]] || die "--wait takes a whole number of minutes"
  if [ "$scope" = "here" ]; then where="under $PWD"; else where="on this host"; fi

  rows=$(_collect_sessions "$scope") || true
  if [ -z "$rows" ]; then
    printf 'no claude sessions %s\n' "$where"
    _paused_note
    return 0
  fi
  while IFS='|' read -r name _rest; do targets+=("$name"); done <<< "$rows"
  if [ "$scope" = "here" ]; then
    elsewhere=$(( $(_collect_sessions all | wc -l) - ${#targets[@]} ))
  fi

  # What is about to happen, then a chance to say no.
  w=$(printf '%s\n' "${targets[@]}" | awk '{ if (length($0) > m) m = length($0) } END { print m }')
  for n in "${targets[@]}"; do
    pane=$(_claude_pane "$n")
    if [ -z "$pane" ] || _pane_dead "$pane"; then
      state="exited"
    elif [ "${TMUX_PANE:-}" = "$pane" ]; then
      state="this one"
    else
      state=$(_pane_input_state "$pane")
    fi
    case "$state" in
      empty)    printf "  %-${w}s  idle       will be paused\n" "$n" ;;
      typing)   printf "  %-${w}s  typing     will be paused, unsent text saved\n" "$n" ;;
      exited)   if [ -f "$(_pause_file "$n")" ]; then
                  printf "  %-${w}s  paused     already paused\n" "$n"
                else
                  printf "  %-${w}s  exited     claude already gone; its exit hint will be read\n" "$n"
                fi ;;
      "this one") printf "  %-${w}s  this one   cannot pause the session this command runs in\n" "$n" ;;
      *)        if [ "$force" -eq 1 ]; then
                  printf "  %-${w}s  %-9s  will be interrupted (--force)\n" "$n" "$state"
                elif [ "$wait_mins" -gt 0 ]; then
                  printf "  %-${w}s  %-9s  will wait up to %dm for it, never interrupt it\n" "$n" "$state" "$wait_mins"
                else
                  printf "  %-${w}s  %-9s  will be left running (--wait 0)\n" "$n" "$state"
                fi ;;
    esac
  done
  if [ "$elsewhere" -gt 0 ]; then
    printf 'note: %d more session(s) outside %s are not included (%s pause --all takes every session on the host)\n' \
      "$elsewhere" "$PWD" "$PROG"
  fi
  if [ "$dry" -eq 1 ]; then
    printf 'dry run: nothing was paused (the manifest would go under %s)\n' "$PAUSE_DIR"
    return 0
  fi
  if [ "$yes" -ne 1 ]; then
    printf 'pause %d session(s) %s? [y/N] ' "${#targets[@]}" "$where"
    read -r ans || ans=""
    case "$ans" in y|Y|yes|YES) ;; *) die "aborted" ;; esac
  fi

  if [ -d "$STATE_DIR/lock" ]; then
    printf 'waiting for a running %s maintain pass...\n' "$PROG"
  fi
  if ! _lock_acquire 60; then
    warn "a '$PROG maintain' pass is still running; continuing anyway"
  fi

  # Remember the tmux maintenance loop too, if one is running: unlike an
  # installed timer or cron job it does not come back on its own.
  if tmux has-session -t "=$MAINT_SESSION" 2>/dev/null; then
    pane=$(tmux list-panes -t "=$MAINT_SESSION" -F '#{pane_id}' 2>/dev/null | head -n 1)
    if [ -n "$pane" ] && ! _pane_dead "$pane"; then
      mkdir -p "$PAUSE_DIR" 2>/dev/null || true
      _pane_fmt "$pane" '#{pane_start_command}' > "$PAUSE_DIR/daemon" 2>/dev/null || true
    fi
  fi

  # Pause what is ready; keep coming back for the rest until the wait is up.
  todo=("${targets[@]}")
  deadline=$(( $(date +%s) + wait_mins * 60 ))
  while :; do
    later=()
    for n in "${todo[@]}"; do
      rc=0; _pause_session "$n" "$force" || rc=$?
      case "$rc" in
        0) paused=$(( paused + 1 )) ;;
        2) later+=("$n") ;;
        *) left+=("$n") ;;
      esac
    done
    [ ${#later[@]} -gt 0 ] || break
    now=$(date +%s)
    if [ "$now" -ge "$deadline" ]; then
      for n in "${later[@]}"; do
        case "$(_pane_input_state "$(_claude_pane "$n")")" in
          busy)   warn "$n: still working$( [ "$wait_mins" -gt 0 ] && printf ' after %dm' "$wait_mins" ); left running (--force interrupts it)" ;;
          dialog) warn "$n: waiting for an answer on screen; left running (answer it, or --force dismisses it)" ;;
          *)      warn "$n: not at a prompt; left running (--force)" ;;
        esac
        left+=("$n")
      done
      break
    fi
    if [ "$first" -eq 1 ]; then
      printf 'waiting up to %dm for %d busy session(s): %s\n' "$wait_mins" "${#later[@]}" "${later[*]}"
      first=0
    fi
    todo=("${later[@]}")
    sleep 5
  done

  printf '\n'
  if [ ${#left[@]} -gt 0 ]; then
    printf '%d of %d session(s) paused; %d left running: %s\n' "$paused" "${#targets[@]}" "${#left[@]}" "${left[*]}"
    printf 'not safe to reboot yet; run "%s pause" again once they are idle\n' "$PROG"
    return 1
  fi
  printf 'all %d session(s) %s paused; after the reboot run: %s reload\n' "${#targets[@]}" "$where" "$PROG"
  if [ "$elsewhere" -gt 0 ]; then
    printf 'note: %d session(s) outside %s are still running\n' "$elsewhere" "$PWD"
  fi
}

cmd_reload() {
  need tmux
  local dry=0 list=0 f n ok=0 failed=0 cmdline pane
  local -a files=() forget=()
  while [ $# -gt 0 ]; do
    case "$1" in
      -n|--dry-run)       dry=1 ;;
      -l|--list|--status) list=1 ;;
      --forget)           [ $# -ge 2 ] || die "--forget needs a session name"; forget+=("$2"); shift ;;
      -h|--help)          help_for reload; return 0 ;;
      *)                  die "unknown option: $1 (try '$PROG help reload')" ;;
    esac
    shift
  done

  if [ ${#forget[@]} -gt 0 ]; then
    for n in "${forget[@]}"; do
      f=$(_pause_file "$n")
      [ -f "$f" ] || f=$(_pause_file "$SESSION_PREFIX$n")
      if [ -f "$f" ]; then
        rm -f "$f"; printf 'forgot %s\n' "${f##*/}"
      else
        warn "$n is not in the manifest"
      fi
    done
    return 0
  fi

  while IFS= read -r f; do [ -n "$f" ] && files+=("$f"); done < <(_pause_files)
  if [ ${#files[@]} -eq 0 ] && [ ! -f "$PAUSE_DIR/daemon" ]; then
    printf 'nothing is paused (no manifest under %s)\n' "$PAUSE_DIR"
    return 0
  fi
  if [ "$list" -eq 1 ] || [ "$dry" -eq 1 ]; then
    [ ${#files[@]} -eq 0 ] || _pause_list
    [ ! -f "$PAUSE_DIR/daemon" ] || printf 'the tmux maintenance loop (%s) would be started again\n' "$MAINT_SESSION"
    [ "$dry" -eq 0 ] || printf 'dry run: nothing was started\n'
    return 0
  fi
  need claude

  if [ -d "$STATE_DIR/lock" ]; then
    printf 'waiting for a running %s maintain pass...\n' "$PROG"
  fi
  if ! _lock_acquire 60; then
    warn "a '$PROG maintain' pass is still running; continuing anyway"
  fi

  for f in "${files[@]}"; do
    if _reload_session "$f"; then ok=$(( ok + 1 )); else failed=$(( failed + 1 )); fi
  done

  if [ -f "$PAUSE_DIR/daemon" ]; then
    if tmux has-session -t "=$MAINT_SESSION" 2>/dev/null; then
      printf '%s: the maintenance loop is already running\n' "$MAINT_SESSION"
    else
      cmdline=$(cat "$PAUSE_DIR/daemon" 2>/dev/null) || cmdline=""
      if [ -n "$cmdline" ] && tmux new-session -d -s "$MAINT_SESSION" -c "$HOME" "$cmdline"; then
        pane=$(tmux list-panes -t "=$MAINT_SESSION" -F '#{pane_id}' 2>/dev/null | head -n 1)
        if [ -n "$pane" ]; then _set_remain "$pane" on; fi
        printf '%s: the maintenance loop is running again\n' "$MAINT_SESSION"
      else
        warn "could not start the maintenance loop again ('$PROG maintain --daemon' does it by hand)"
      fi
    fi
    rm -f "$PAUSE_DIR/daemon"
  fi

  if [ ${#files[@]} -gt 0 ]; then
    printf '\n%d of %d session(s) back\n' "$ok" "${#files[@]}"
    if [ "$failed" -gt 0 ]; then
      printf '%d could not be started and stay in the manifest; run "%s reload" again to retry them\n' "$failed" "$PROG"
    fi
    printf '\n'
    cmd_list --all
  fi
  [ "$failed" -eq 0 ]
}

cmd_kill() {
  need tmux
  local all=0 force=0
  local args=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --all)      all=1 ;;
      -f|--force) force=1 ;;
      -h|--help)  help_for kill; return 0 ;;
      --)         shift; args+=("$@"); break ;;
      -*)         die "unknown option: $1 (try '$PROG help kill')" ;;
      *)          args+=("$1") ;;
    esac
    shift
  done

  if [ "$all" -eq 1 ]; then
    [ ${#args[@]} -gt 0 ] && die "cannot combine --all with a name or index"
    local rows; rows=$(_collect_sessions "here") || true
    if [ -z "$rows" ]; then
      printf 'no claude sessions under %s\n' "$PWD"
      return 0
    fi
    if [ "$force" -ne 1 ]; then
      local count; count=$(printf '%s\n' "$rows" | wc -l)
      printf 'kill %d session(s) under %s? [y/N] ' "$count" "$PWD"
      read -r ans || ans=""
      case "$ans" in y|Y|yes|YES) ;; *) die "aborted" ;; esac
    fi
    local name _rest
    while IFS='|' read -r name _rest; do
      if tmux kill-session -t "=$name" 2>/dev/null; then
        printf 'killed %s\n' "$name"
      else
        printf 'failed to kill %s\n' "$name" >&2
      fi
    done <<< "$rows"
    return 0
  fi

  [ ${#args[@]} -eq 0 ] && die "missing session name or # (try '$PROG help kill')"
  local target
  target=$(_resolve_session "${args[0]}")
  tmux kill-session -t "=$target"
  printf 'killed %s\n' "$target"
}

cmd_install() {
  local dest_dir="$HOME/.local/bin"
  local force=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --system)   dest_dir="/usr/local/bin" ;;
      --force)    force=1 ;;
      -h|--help)  help_for install; return 0 ;;
      *)          die "unknown option: $1 (try '$PROG help install')" ;;
    esac
    shift
  done

  local src dest
  src="$(_self_path)"
  dest="$dest_dir/cmm"

  mkdir -p "$dest_dir" 2>/dev/null || true
  [ -d "$dest_dir" ] || die "destination directory does not exist: $dest_dir"
  [ -w "$dest_dir" ] || die "destination directory is not writable: $dest_dir (try sudo)"

  if [ -e "$dest" ] && [ "$force" -ne 1 ]; then
    if [ "$src" -ef "$dest" ]; then
      printf 'already installed at %s\n' "$dest"
      return 0
    fi
    printf 'overwrite existing %s? [y/N] ' "$dest"
    read -r ans || ans=""
    case "$ans" in y|Y|yes|YES) ;; *) die "aborted" ;; esac
  fi

  install -m 0755 "$src" "$dest" 2>/dev/null \
    || { cp "$src" "$dest" && chmod 0755 "$dest"; }
  printf 'installed: %s\n' "$dest"

  case ":$PATH:" in
    *":$dest_dir:"*) ;;
    *) printf 'note: %s is not on your PATH\n' "$dest_dir" ;;
  esac
}

cmd_version() { printf '%s %s\n' "$PROG" "$VERSION"; }

# ---------- dispatch ----------

main() {
  if [ $# -eq 0 ]; then usage; exit 0; fi
  local cmd="$1"; shift
  case "$cmd" in
    list|ls)              cmd_list      "$@" ;;
    new|start)            cmd_new       "$@" ;;
    resume|attach|a)      cmd_resume    "$@" ;;
    update|upgrade)       cmd_update    "$@" ;;
    restart)              cmd_restart   "$@" ;;
    pause|suspend)        cmd_pause     "$@" ;;
    reload|unpause)       cmd_reload    "$@" ;;
    maintain|keepalive|watchdog) cmd_maintain "$@" ;;
    kill|stop)            cmd_kill      "$@" ;;
    install)              cmd_install   "$@" ;;
    help|-h|--help)       help_for      "${1:-}" ;;
    version|-v|--version) cmd_version ;;
    *) die "unknown command: $cmd (try '$PROG help')" ;;
  esac
}

main "$@"
